---
const nav = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/beliefs', label: 'What we believe' },
  { href: '/conferences', label: 'Conferences' },
  { href: '/journal', label: 'Journal' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="border-b border-rule bg-paper/90 backdrop-blur sticky top-0 z-10">
  <div class="mx-auto max-w-6xl px-6 py-4 flex items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-3 no-underline">
      <img src="/img/brand-mark.png" alt="" class="h-9 w-9 rounded-md shadow-[0_1px_0_rgba(0,0,0,0.04)]" />
      <span class="font-serif text-lg leading-tight">
        <span class="block font-semibold tracking-tight">British Reformed</span>
        <span class="block text-xs uppercase tracking-[0.18em] text-muted">Fellowship</span>
      </span>
    </a>
    <nav class="hidden md:flex items-center gap-7 font-sans text-sm">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'no-underline text-ink/80 hover:text-ink',
            path === item.href && 'text-oxblood font-medium',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <a href="/donate" class="hidden md:inline-block font-sans text-sm bg-oxblood text-paper px-4 py-2 rounded-sm no-underline hover:bg-[#5e1717]">Donate</a>
  </div>
</header>
