---
/**
 * BibleUp — auto-detects scripture references in article body and shows the
 * verse text in a hover popover (no editor effort required). Scoped to the
 * parent .prose-brand container; not initialised if there is no article body
 * on the page (so other pages stay quiet).
 *
 * Click-to-pin (issue #5): mirrors the footnote popup behaviour. A click on
 * the scripture reference in the article body keeps the popup open after
 * the cursor leaves the link. A second click, the close button, Escape,
 * clicking the same link again, or moving the cursor away from both the
 * link and the popup dismisses it.
 */
interface Props {
  version?: 'KJV' | 'ASV' | 'LSV' | 'WEB';
}
const { version = 'KJV' } = Astro.props;
---
<script is:inline src="https://cdn.jsdelivr.net/npm/@bibleup/bibleup@1"></script>
<script is:inline define:vars={{ version }}>
  (function () {
    function init() {
      var target = document.querySelector('.prose-brand');
      if (!target || !window.BibleUp) return;
      var bu = new window.BibleUp(target, {
        version: version,
        popup: 'wiki',
        darkTheme: document.documentElement.getAttribute('data-theme') === 'dark',
        ignoreCase: true,
        bu_ignore: ['BLOCKQUOTE', 'NAV', 'HEADER', 'FOOTER'],
      });
      bu.create();

      // --- Click-to-pin (issue #5) ---------------------------------------
      // BibleUp only opens on hover, and closes as soon as the cursor
      // leaves the link. After a click we want the popup to behave like
      // the footnote popup: stay visible until the user actively dismisses
      // it. We achieve that by simulating a cursor-leave on the link (so
      // BibleUp's internal #closePopup schedules its hide) but then, if a
      // pin flag is set, cancelling the close by putting the cursor back
      // on the popup via #mouseOnPopup semantics — which we cannot read.
      //
      // Cleanest approach without monkey-patching BibleUp internals:
      // - On click, toggle a .bu-pinned class on the popup and add
      //   display:flex / opacity:1 !important via CSS (we override the
      //   .bu-popup-hide styles for .bu-popup-pinned in global.css).
      // - Add Escape and close-button handlers ourselves.
      // - On any click outside the popup or link while pinned, unpin and
      //   let BibleUp's own teardown run.
      var popup = document.querySelector('[id^="bu-popup-"]');
      if (!popup) return;
      var links = target.querySelectorAll('[class*="bu-link"]');

      links.forEach(function (link) {
        link.addEventListener('click', function (e) {
          // BibleUp already preventsDefault on the link; wait one tick so
          // its own click handler runs first and the popup is visible.
          setTimeout(function () {
            var open = popup && !popup.classList.contains('bu-popup-hide');
            if (!open) return;
            var wasPinned = popup.classList.contains('bu-popup-pinned');
            popup.classList.toggle('bu-popup-pinned', !wasPinned);
          }, 0);
        });
      });

      function unpin() {
        if (!popup) return;
        if (!popup.classList.contains('bu-popup-pinned')) return;
        popup.classList.remove('bu-popup-pinned');
      }

      // Escape dismisses a pinned popup.
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') unpin();
      });

      // The BibleUp close button always closes the popup; unpin first so
      // state stays in sync with visibility.
      var observer = new MutationObserver(function () {
        var closeBtn = popup && popup.querySelector('.bu-popup-close');
        if (!closeBtn || closeBtn.__wired) return;
        closeBtn.__wired = true;
        closeBtn.addEventListener('click', unpin);
      });
      if (popup) observer.observe(popup, { childList: true, subtree: true });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
    document.addEventListener('astro:page-load', init);
  })();
</script>
