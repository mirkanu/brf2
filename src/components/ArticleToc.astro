---
// Sticky table of contents for journal articles.
//
// Reads rendered headings from a journal body and renders a two-level nav
// (H2 sections, with H3 sub-entries indented underneath). The list itself is
// plain HTML, so it works without JavaScript; the scroll-spy below adds the
// "currently in view" highlight without affecting layout.
//
// Active-section detection uses a single IntersectionObserver with a rootMargin
// biased toward the top quarter of the viewport — that's the Vercel docs /
// Tailwind UI pattern that avoids both the "stuck on first item" and the
// "flips through every item" failure modes.

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const h2Count = headings.filter((h) => h.depth === 2).length;
---

{headings.length > 0 && (
  <nav class="article-toc" aria-label="Table of contents">
    <a class="article-toc__top" href="#" data-toc-top>↑ Back to top</a>
    <p class="article-toc-label">Sections</p>
    <ol class="article-toc-list">
      {headings.map((heading) => (
        <li
          class:list={[
            'article-toc-item',
            heading.depth === 3 && 'article-toc-item--sub',
          ]}
        >
          <a
            href={`#${heading.slug}`}
            class="article-toc-link"
            data-toc-link={heading.slug}
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}

{h2Count >= 2 && (
  <script>
    // Scroll-spy: highlight the heading the reader is currently under.
    // Pattern (Vercel docs style): a single rootMargin band near the top
    // of the viewport. To keep the *current* heading highlighted all the
    // way down a long body section — instead of clearing until the next
    // heading enters the band — we hold the last chosen heading active
    // until a new one shows up.
    (() => {
      const links = Array.from(document.querySelectorAll('[data-toc-link]'));
      if (links.length === 0) return;

      const linkBySlug = new Map();
      for (const link of links) {
        const slug = link.getAttribute('data-toc-link');
        if (slug) linkBySlug.set(slug, link);
      }

      const targets = [];
      for (const link of links) {
        const id = link.getAttribute('data-toc-link');
        const el = id ? document.getElementById(id) : null;
        if (id && el) targets.push({ id, el });
      }
      if (targets.length === 0) return;

      let activeSlug = null;
      const setActive = (slug) => {
        if (slug === activeSlug) return;
        if (activeSlug) {
          const prev = linkBySlug.get(activeSlug);
          if (prev) prev.removeAttribute('aria-current');
        }
        activeSlug = slug;
        if (slug) {
          const next = linkBySlug.get(slug);
          if (next) next.setAttribute('aria-current', 'location');
        }
      };

      // When an H3 is the active scroll target, still highlight its parent
      // H2 in the list — that mirrors how readers scan an outline.
      const ownerH2 = (el) => {
        let cur = el;
        while (cur && cur.tagName !== 'H2') {
          cur = cur.previousElementSibling;
        }
        return (cur || el).id;
      };

      // Pick the heading whose top edge has most recently crossed an
      // imaginary horizontal line near the top of the viewport (just
      // below the sticky site header). That heading is "the one the
      // reader is currently reading under" — and it stays active all
      // the way down the section body until the next heading crosses
      // the line.
      const ACTIVE_LINE = 96; // px from top of viewport (header + a little air)
      let ticking = false;

      const update = () => {
        ticking = false;
        let chosen = null;
        for (const t of targets) {
          if (t.el.getBoundingClientRect().top - ACTIVE_LINE <= 0) {
            chosen = t;
          } else {
            break; // targets are in document order; once we pass the line, stop
          }
        }
        const id = chosen ? ownerH2(chosen.el) : null;
        setActive(id);
      };

      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();
    })();
  </script>
)}
