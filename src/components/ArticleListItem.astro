---
import { fmtDate } from '../lib/format';
import { decodeEntities } from '../lib/text';
import type { CollectionEntry } from 'astro:content';

type AnyEntry = CollectionEntry<'journal'> | CollectionEntry<'conferences'> | CollectionEntry<'podcasts'>;

interface Props {
  entry: AnyEntry;
  href?: string;
}

const { entry, href } = Astro.props;
const { title: rawTitle, datePublished, primaryCategory, legacyPath } = entry.data as any;
const title = decodeEntities(rawTitle);
const issueNumber = (entry.data as any).issueNumber as number | null | undefined;
const issueYear = (entry.data as any).issueYear as number | null | undefined;
const authorNames: string[] = Array.isArray((entry.data as any).authors)
  ? (entry.data as any).authors.filter((s: string) => s && s.trim().length > 0)
  : [];
const link = href ?? `/${entry.collection}/${entry.id.replace(/\.json$/, '')}`;
---
<li class="py-4">
  <a href={link} class="block hover:underline">
    <div class="flex items-baseline justify-between gap-4">
      <p class="font-serif text-lg text-brand-ink leading-snug">{title}</p>
      {datePublished && <time class="shrink-0 text-xs text-muted tabular-nums">{fmtDate(datePublished)}</time>}
    </div>
    <p class="mt-1 flex flex-wrap gap-x-3 gap-y-0.5 text-xs text-brand-ink/65">
      {authorNames.length > 0 && <span>{authorNames.join(', ')}</span>}
      {issueYear != null && <span>{issueYear}</span>}
      {issueNumber != null && <span>Issue {issueNumber}</span>}
      {primaryCategory && <span>{primaryCategory}</span>}
    </p>
  </a>
</li>
