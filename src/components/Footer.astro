---
const year = new Date().getFullYear();
---
<footer class="border-t border-rule mt-16 bg-paper">
  <div class="mx-auto max-w-6xl px-6 py-12 grid gap-10 md:grid-cols-4">
    <div class="md:col-span-2">
      <p class="font-serif text-base font-semibold tracking-tight">British Reformed Fellowship</p>
      <p class="mt-2 text-sm text-muted max-w-md">A fellowship of Reformed Christians promoting knowledge of the Reformed Faith in the British Isles and beyond.</p>
    </div>
    <div>
      <p class="font-sans text-xs uppercase tracking-[0.18em] text-muted">Fellowship</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/about/" class="hover:text-ink">About</a></li>
        <li><a href="/conferences/" class="hover:text-ink">Conferences</a></li>
        <li><a href="/journal/" class="hover:text-ink">Journal</a></li>
        <li><a href="/podcasts/" class="hover:text-ink">Podcasts</a></li>
        <li><a href="/literature/" class="hover:text-ink">Literature</a></li>
      </ul>
    </div>
    <div>
      <p class="font-sans text-xs uppercase tracking-[0.18em] text-muted">Connect</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/about/contact/" class="hover:text-ink">Contact</a></li>
        <li><a href="mailto:secretary@britishreformed.org" class="hover:text-ink">secretary@britishreformed.org</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-rule">
    <div class="mx-auto max-w-6xl px-6 py-6 text-xs text-muted flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
      <p>© {year} British Reformed Fellowship. Registered charity.</p>
      <p>Built with care in the British Isles.</p>
    </div>
  </div>
</footer>
