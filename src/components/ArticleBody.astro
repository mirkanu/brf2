---
import Breadcrumbs from './Breadcrumbs.astro';
import { fmtDate } from '../lib/format';
import type { CollectionEntry } from 'astro:content';

type AnyEntry = CollectionEntry<'journal'> | CollectionEntry<'conferences'> | CollectionEntry<'podcasts'>;

// Reading-time estimate: 225 wpm is a comfortable pace for long-form prose.
// We measure the rendered body via the slot-less snapshot is not available,
// so estimate from a 0.6k/page heuristic on the rendered HTML when possible.
// Fallback: when no body string is supplied, return null so the badge hides.
function estimateMinutes(html: string | undefined): number | null {
  if (!html) return null;
  const text = html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
  const words = text.split(' ').filter(Boolean).length;
  if (words === 0) return null;
  return Math.max(1, Math.round(words / 225));
}
// The slot child is not available at the frontmatter boundary in Astro;
// we compute the estimate at render time from the slipped-through value.

interface Props {
  entry: AnyEntry;
  breadcrumbs?: { label: string; href?: string }[];
  showAudio?: boolean;
}

const { entry, breadcrumbs, showAudio = false } = Astro.props;
const { title, datePublished, primaryCategory, rawCategories, legacyPath } = entry.data as any;
const issueNumber = (entry.data as any).issueNumber as number | null | undefined;
const issueYear = (entry.data as any).issueYear as number | null | undefined;

const authorNames: string[] = Array.isArray((entry.data as any).authors)
  ? (entry.data as any).authors.filter((s: string) => s && s.trim().length > 0)
  : [];

const sectionLabel = (entry.collection === 'conferences') ? 'Conference' : (entry.collection === 'podcasts' ? 'Podcast' : 'Article');
const bc = breadcrumbs ?? (entry.collection === 'conferences'
  ? [
      { label: 'Home', href: '/' },
      { label: 'Conferences', href: '/conferences' },
    ]
  : entry.collection === 'podcasts'
  ? [
      { label: 'Home', href: '/' },
      { label: 'Podcasts', href: '/podcasts' },
    ]
  : [
      { label: 'Home', href: '/' },
      { label: 'Journal', href: '/journal' },
    ]);
---
<section class="bg-brand-cream border-b border-brand-ink/10">
  <div class="max-w-3xl mx-auto px-6 py-10">
    <Breadcrumbs items={bc} />
    <p class="mt-3 text-xs uppercase tracking-wider text-muted">
      {sectionLabel}
      {issueYear != null && (<span> · {issueYear}</span>)}
      {issueNumber != null && (<span> · Issue {issueNumber}</span>)}
      {primaryCategory && (<span> · {primaryCategory}</span>)}
    </p>
    <h1 class="mt-3 font-serif text-3xl md:text-4xl text-brand-ink leading-tight tracking-tight">{title}</h1>
    {(authorNames.length > 0 || (Astro.props.bodyText && Astro.props.bodyText.length > 0)) && (
      <p class="mt-3 text-sm text-brand-ink/75 flex flex-wrap items-center gap-x-2 gap-y-1">
        {authorNames.length > 0 && (
          <span>{authorNames.length === 1 ? authorNames[0] : authorNames.join(', ')}</span>
        )}
        {datePublished && (<span>{fmtDate(datePublished)}</span>)}
        {(() => {
          const mins = estimateMinutes(Astro.props.bodyText);
          return mins ? <span class="reading-time" aria-label={`Estimated reading time: ${mins} minutes`}>{mins} min read</span> : null;
        })()}
      </p>
    )}
    {legacyPath && (
      <p class="mt-2 text-xs text-muted">Originally at {legacyPath}</p>
    )}
  </div>
</section>

{showAudio && (
  <section class="bg-brand-parchment border-b border-brand-ink/10">
    <div class="max-w-3xl mx-auto px-6 py-6">
      <div class="bg-[var(--paper)] border border-brand-ink/15 rounded-md p-4 font-sans text-sm text-brand-ink/70">
        Audio player placeholder — the original podcast MP3 lives at the linked archive.
      </div>
    </div>
  </section>
)}

<section class="bg-[var(--paper)]">
  <div class="max-w-3xl mx-auto px-6 py-10">
    <article class="prose prose-brand max-w-none">
      <slot />
    </article>
    {rawCategories && rawCategories.length > 0 && (
      <div class="mt-8 border-t border-brand-ink/10 pt-6 font-sans text-xs text-muted">
        Filed under: {rawCategories.join(', ')}
      </div>
    )}
  </div>
</section>
