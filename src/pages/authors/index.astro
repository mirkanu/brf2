---
import Site from '../../layouts/Site.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('journal');

type AuthorRow = {
  name: string;
  slug: string;
  articleCount: number;
  types: Set<string>;
};

const authorMap = new Map<string, AuthorRow>();
for (const entry of allArticles) {
  const names = entry.data.authors;
  if (!names || names.length === 0) continue;
  const type = entry.data.section ?? 'journal';
  for (const name of names) {
    const cleanName = name.trim();
    if (!cleanName || cleanName.toLowerCase() === 'unknown' || cleanName.toLowerCase() === 'admin') continue;
    const slug = cleanName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    const existing = authorMap.get(cleanName);
    if (existing) {
      existing.articleCount += 1;
      existing.types.add(type);
    } else {
      authorMap.set(cleanName, { name: cleanName, slug, articleCount: 1, types: new Set([type]) });
    }
  }
}

const authors = Array.from(authorMap.values()).sort((a, b) => b.articleCount - a.articleCount);
---
<Site title="Authors" description="Browse BRF content by author.">
  <div class="border-b border-[var(--border)] bg-[var(--surface-1)]">
    <div class="mx-auto max-w-6xl px-6 py-12">
      <h1 class="font-serif text-4xl md:text-5xl leading-[1.05] tracking-tight">Authors</h1>
      <p class="mt-3 text-[var(--muted)] max-w-2xl">
        Every article, conference paper, podcast, and literature item, organised by author.
      </p>
      <p class="mt-4 text-sm text-[var(--muted)]">
        {authors.length} {authors.length === 1 ? 'author' : 'authors'}
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-6 py-12">
    {authors.length === 0 ? (
      <p class="text-[var(--muted)]">No authors found.</p>
    ) : (
      <div class="grid grid-cols-1 gap-y-3 sm:grid-cols-2 md:grid-cols-3">
        {authors.map((author) => (
          <a
            href={`/authors/${author.slug}`}
            class="group flex items-baseline justify-between rounded-md border border-transparent px-3 py-2 hover:border-[var(--border)] hover:bg-[var(--surface-1)]"
          >
            <span class="font-medium text-[var(--foreground)] group-hover:text-[var(--accent)]">{author.name}</span>
            <span class="text-xs text-[var(--muted)] tabular-nums">{author.articleCount}</span>
          </a>
        ))}
      </div>
    )}
  </div>
</Site>
