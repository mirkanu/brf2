---
import Site from '../../layouts/Site.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allArticles = await getCollection('journal');
  const authorMap = new Map<string, { name: string; slug: string }>();
  for (const entry of allArticles) {
    for (const name of entry.data.authors ?? []) {
      const cleanName = name.trim();
      if (!cleanName || cleanName.toLowerCase() === 'unknown' || cleanName.toLowerCase() === 'admin') continue;
      const slug = cleanName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      if (!authorMap.has(slug)) authorMap.set(slug, { name: cleanName, slug });
    }
  }
  return Array.from(authorMap.values()).map(({ name, slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const allArticles = await getCollection('journal');
const entries = allArticles
  .filter((entry) => (entry.data.authors ?? []).some((name) => {
    const cleanName = name.trim();
    if (!cleanName || cleanName.toLowerCase() === 'unknown' || cleanName.toLowerCase() === 'admin') return false;
    return cleanName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') === slug;
  }))
  .sort((a, b) => new Date(b.data.datePublished).getTime() - new Date(a.data.datePublished).getTime());

const displayName = entries[0]?.data.authors?.find((name) => {
  const cleanName = name.trim();
  return cleanName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') === slug;
})?.trim() ?? slug;
---
<Site title={displayName} description={`Articles and other content by ${displayName}.`}>
  <div class="border-b border-[var(--border)] bg-[var(--surface-1)]">
    <div class="mx-auto max-w-6xl px-6 py-12">
      <p class="text-sm uppercase tracking-widest text-[var(--accent)]">Author</p>
      <h1 class="font-serif text-4xl md:text-5xl leading-[1.05] tracking-tight">{displayName}</h1>
      <p class="mt-3 text-[var(--muted)] max-w-2xl">
        {entries.length} {entries.length === 1 ? 'piece' : 'pieces'} published across the British Reformed Fellowship.
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-6 py-12">
    {entries.length === 0 ? (
      <p class="text-[var(--muted)]">No content from this author yet.</p>
    ) : (
      <ul class="grid grid-cols-1 gap-x-8 gap-y-10 md:grid-cols-2 lg:grid-cols-3">
        {entries.map((entry) => <ArticleCard article={entry} />)}
      </ul>
    )}
  </div>
</Site>
