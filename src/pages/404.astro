---
import Site from '../layouts/Site.astro';
---
<Site title="Page not found · British Reformed Fellowship" description="The requested page could not be found.">
  <section class="mx-auto max-w-prose px-6 py-24 text-center">
    <p class="font-sans text-xs uppercase tracking-widest text-brand-muted">404</p>
    <h1 class="mt-3 font-serif text-4xl text-brand-ink">Page not found</h1>
    <p class="mt-4 text-brand-muted">
      The requested page could not be found. Try the
      <a href="/" class="underline hover:text-brand-ink">homepage</a> or the
      <a href="/journal/" class="underline hover:text-brand-ink">journal index</a>.
    </p>
  </section>
</Site>
