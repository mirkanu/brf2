---
import Site from '../layouts/Site.astro';
---
<Site title="Donate — British Reformed Fellowship">
  <section class="mx-auto max-w-3xl px-6 py-12">
    <p class="font-sans text-xs uppercase tracking-[0.22em] text-oxblood">Donate</p>
    <h1 class="font-serif text-4xl md:text-5xl tracking-tight mt-3 text-balance">Support the work of the fellowship.</h1>
    <p class="font-serif text-lg text-muted mt-5 max-w-2xl">The British Reformed Fellowship is a registered charity. Gifts support our conferences, the British Reformed Journal, and the podcast feed.</p>

    <div class="mt-12 grid md:grid-cols-2 gap-10 font-sans text-sm">
      <div class="border border-rule p-6">
        <h2 class="font-serif text-2xl text-ink">Single gift</h2>
        <p class="text-muted mt-2">One-off donation by bank transfer.</p>
        <dl class="mt-6 space-y-3">
          <div class="grid grid-cols-[120px_1fr] gap-2"><dt class="text-muted">Account name</dt><dd>British Reformed Fellowship</dd></div>
          <div class="grid grid-cols-[120px_1fr] gap-2"><dt class="text-muted">Sort code</dt><dd>00-00-00</dd></div>
          <div class="grid grid-cols-[120px_1fr] gap-2"><dt class="text-muted">Account no.</dt><dd>00000000</dd></div>
          <div class="grid grid-cols-[120px_1fr] gap-2"><dt class="text-muted">Reference</dt><dd>Your name</dd></div>
        </dl>
      </div>
      <div class="border border-rule p-6">
        <h2 class="font-serif text-2xl text-ink">Regular gift</h2>
        <p class="text-muted mt-2">Standing order or Gift Aid declaration.</p>
        <p class="mt-6 leading-relaxed">Download the <a href="/s/BRF-Standing-Order.pdf" class="text-oxblood no-underline hover:underline">standing order form</a> and the <a href="/s/BRF-Gift-Aid.pdf" class="text-oxblood no-underline hover:underline">Gift Aid declaration</a>, complete, and return to the secretary.</p>
      </div>
    </div>

    <div class="mt-12 border-t border-rule pt-8 font-sans text-sm text-muted">
      <p><strong class="text-ink">Gift Aid.</strong> If you are a UK taxpayer, the value of your gift can be increased by 25% at no extra cost to you. Tick the Gift Aid declaration on the form and return it to the secretary.</p>
    </div>
  </section>
</Site>
