---
import Site from '../layouts/Site.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Site title="British Reformed Fellowship">
  <Header />

  <!-- Hero: panoramic lava strip, then copy card below -->
  <section class="relative">
    <div class="relative h-[42vh] min-h-[280px] max-h-[460px] overflow-hidden bg-[#2a1a14]">
      <img
        src="/img/hero-lava.gif"
        alt=""
        class="absolute inset-0 h-full w-full object-cover object-center"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-black/25 via-transparent to-black/15"></div>
      <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-b from-transparent to-[#fbf8f3]"></div>
    </div>

    <div class="mx-auto max-w-6xl px-6 -mt-16 md:-mt-24 relative">
      <div class="bg-paper border border-rule shadow-[0_2px_24px_rgba(26,26,26,0.06)] p-8 md:p-12">
        <p class="font-sans text-xs uppercase tracking-[0.22em] text-oxblood">A confessional Reformed fellowship</p>
        <h1 class="font-serif text-4xl md:text-6xl leading-[1.05] tracking-tight mt-4 text-balance">
          Holding fast the faithful Word,<br />
          for the churches of these islands.
        </h1>
        <p class="font-serif text-lg md:text-xl text-muted mt-6 max-w-prose">
          Conferences, publications, and a quarterly journal committed to the historic Christian faith and the Westminster Standards.
        </p>
        <div class="mt-8 flex flex-wrap gap-3 font-sans text-sm">
          <a href="/conferences" class="bg-oxblood text-paper px-5 py-2.5 rounded-sm no-underline hover:bg-[#5e1717]">Upcoming conferences</a>
          <a href="/journal" class="border border-rule px-5 py-2.5 rounded-sm no-underline hover:bg-[#f3eee2]">Read the Journal</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Now strip -->
  <section class="mx-auto max-w-6xl px-6 py-10 grid md:grid-cols-3 gap-10 font-sans text-sm">
    <div class="border-t border-oxblood pt-5">
      <p class="text-xs uppercase tracking-[0.18em] text-muted">Now</p>
      <p class="mt-2 font-serif text-base text-ink/90">Summer Conference 2026</p>
      <p class="mt-1 text-muted">21–24 July · High Leigh Conference Centre</p>
    </div>
    <div class="border-t border-oxblood pt-5">
      <p class="text-xs uppercase tracking-[0.18em] text-muted">Latest issue</p>
      <p class="mt-2 font-serif text-base text-ink/90">British Reformed Journal 184</p>
      <p class="mt-1 text-muted">Christ and the covenant — out now</p>
    </div>
    <div class="border-t border-oxblood pt-5">
      <p class="text-xs uppercase tracking-[0.18em] text-muted">Listen</p>
      <p class="mt-2 font-serif text-base text-ink/90">Conference lectures, on demand</p>
      <p class="mt-1 text-muted">Available as a podcast feed</p>
    </div>
  </section>

  <!-- Three pillars -->
  <section class="mx-auto max-w-6xl px-6 pb-20 grid md:grid-cols-3 gap-10 font-serif">
    <article class="border-t border-oxblood pt-5">
      <p class="font-sans text-xs uppercase tracking-[0.18em] text-muted">Journal</p>
      <h2 class="text-2xl mt-2 leading-snug">The latest from the British Reformed Journal</h2>
      <p class="text-muted mt-3">Essays, reviews, and sermons from ministers and scholars across the Reformed tradition.</p>
      <a href="/journal" class="font-sans text-sm text-oxblood mt-4 inline-block">Browse the archive →</a>
    </article>
    <article class="border-t border-oxblood pt-5">
      <p class="font-sans text-xs uppercase tracking-[0.18em] text-muted">Conferences</p>
      <h2 class="text-2xl mt-2 leading-snug">A week of preaching, teaching, and fellowship</h2>
      <p class="text-muted mt-3">Held each summer at High Leigh, with a smaller winter conference and regional meetings.</p>
      <a href="/conferences" class="font-sans text-sm text-oxblood mt-4 inline-block">See what's planned →</a>
    </article>
    <article class="border-t border-oxblood pt-5">
      <p class="font-sans text-xs uppercase tracking-[0.18em] text-muted">Podcasts</p>
      <h2 class="text-2xl mt-2 leading-snug">Conference lectures and conversations</h2>
      <p class="text-muted mt-3">Every lecture from our conferences, in one feed. Subscribe wherever you listen.</p>
      <a href="/podcast" class="font-sans text-sm text-oxblood mt-4 inline-block">Listen or subscribe →</a>
    </article>
  </section>

  <Footer />
</Site>
