---
import Site from '../layouts/Site.astro';
import { getCollection } from 'astro:content';
import { render } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';

const pages = await getCollection('pages');
const home = pages.find(p => p.id === 'home');
const { Content: HomeBody } = home ? await render(home) : { Content: null };

const journal = await getCollection('journal');
const podcasts = await getCollection('podcasts');
const conferences = await getCollection('conferences');

const latestJournal = journal
  .filter(j => j.data.datePublished)
  .sort((a, b) => b.data.datePublished.localeCompare(a.data.datePublished))
  .slice(0, 5);

const latestPodcasts = podcasts
  .filter(p => p.data.datePublished)
  .sort((a, b) => b.data.datePublished.localeCompare(a.data.datePublished))
  .slice(0, 4);

const currentYear = new Date().getFullYear();
const upcoming = conferences
  .filter(c => c.data.year >= currentYear)
  .sort((a, b) => a.data.year - b.data.year)[0];

// Past conferences by year desc, top 3
const pastConfs = conferences
  .filter(c => c.data.year < currentYear)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 3);

function fmtDate(iso: string | undefined): string {
  if (!iso) return '';
  const d = new Date(iso);
  if (isNaN(d.getTime())) return iso;
  return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}
---
<Site title="British Reformed Fellowship — Confessing the Reformed Faith in the British Isles">
  <!-- Hero / intro -->
  <section class="bg-brand-cream border-b border-brand-ink/10">
    <div class="max-w-5xl mx-auto px-6 py-16 md:py-24">
      <h1 class="font-serif text-4xl md:text-6xl leading-[1.05] tracking-tight text-brand-ink">
        Confessing the<br />Reformed Faith<br />in the British Isles
      </h1>
      {HomeBody && (
        <div class="prose mt-8 max-w-3xl text-lg text-brand-ink/80">
          <HomeBody />
        </div>
      )}
      <div class="mt-10 flex flex-wrap gap-3">
        <a href="/conferences" class="inline-flex items-center rounded-md bg-brand-ink px-5 py-3 font-medium text-white hover:bg-brand-ink/90">Conferences</a>
        <a href="/journal" class="inline-flex items-center rounded-md border border-brand-ink/30 px-5 py-3 font-medium text-brand-ink hover:bg-brand-ink/5">The Journal</a>
        <a href="/podcasts" class="inline-flex items-center rounded-md border border-brand-ink/30 px-5 py-3 font-medium text-brand-ink hover:bg-brand-ink/5">Podcasts</a>
      </div>
    </div>
  </section>

  {upcoming && (
    <section class="bg-brand-parchment border-b border-brand-ink/10">
      <div class="max-w-5xl mx-auto px-6 py-12">
        <p class="text-sm font-medium uppercase tracking-wider text-muted">Upcoming Conference</p>
        <h2 class="mt-2 font-serif text-3xl md:text-4xl text-brand-ink">
          <a href={`/conferences/${upcoming.data.year}`} class="hover:underline">{upcoming.data.title}</a>
        </h2>
        <p class="mt-3 text-brand-ink/70">{upcoming.data.subtitle}</p>
        <a href="/conferences" class="mt-6 inline-block text-brand-ink font-medium underline underline-offset-4">View all conferences →</a>
      </div>
    </section>
  )}

  <!-- Latest from the Journal -->
  <section class="bg-white border-b border-brand-ink/10">
    <div class="max-w-5xl mx-auto px-6 py-14">
      <div class="flex items-end justify-between border-b border-brand-ink/20 pb-4">
        <h2 class="font-serif text-2xl md:text-3xl text-brand-ink">From the Journal</h2>
        <a href="/journal" class="text-sm font-medium text-brand-ink/70 hover:text-brand-ink underline underline-offset-4">Browse all →</a>
      </div>
      <ul class="mt-8 grid gap-6 md:grid-cols-2">
        {latestJournal.map(item => <ArticleCard item={item} />)}
      </ul>
    </div>
  </section>

  <!-- Latest Podcasts -->
  {latestPodcasts.length > 0 && (
    <section class="bg-brand-cream border-b border-brand-ink/10">
      <div class="max-w-5xl mx-auto px-6 py-14">
        <div class="flex items-end justify-between border-b border-brand-ink/20 pb-4">
          <h2 class="font-serif text-2xl md:text-3xl text-brand-ink">Recent Podcasts</h2>
          <a href="/podcasts" class="text-sm font-medium text-brand-ink/70 hover:text-brand-ink underline underline-offset-4">All podcasts →</a>
        </div>
        <ul class="mt-8 grid gap-6 md:grid-cols-2">
          {latestPodcasts.map(p => (
            <li class="rounded-lg border border-brand-ink/15 bg-white p-5">
              <p class="font-serif text-lg text-brand-ink">{p.data.title}</p>
              {p.data.authors?.[0] && <p class="mt-1 text-sm text-muted">{p.data.authors[0]}</p>}
              {p.data.datePublished && <p class="mt-1 text-xs text-muted">{fmtDate(p.data.datePublished)}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {pastConfs.length > 0 && (
    <section class="bg-brand-parchment">
      <div class="max-w-5xl mx-auto px-6 py-14">
        <h2 class="font-serif text-2xl md:text-3xl text-brand-ink border-b border-brand-ink/20 pb-4">Past Conferences</h2>
        <ul class="mt-6 grid gap-3 md:grid-cols-3">
          {pastConfs.map(c => (
            <li class="rounded-lg border border-brand-ink/15 bg-white p-5">
              <p class="text-xs uppercase tracking-wider text-muted">{c.data.year}</p>
              <p class="mt-2 font-serif text-lg text-brand-ink">{c.data.title}</p>
              {c.data.subtitle && <p class="mt-1 text-sm text-brand-ink/70">{c.data.subtitle}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Site>
