---
import Site from '../../layouts/Site.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ConferenceRecordings from '../../components/ConferenceRecordings.astro';
import { getCollection, render } from 'astro:content';
import { speakerSlug } from '../../lib/speakers';
import { fmtDate } from '../../lib/format';
import { site } from '../../lib/site-config';

export async function getStaticPaths() {
  const all = await getCollection('conferences');
  const yearEntries = all.filter((c) => {
    const y = c.data.year;
    return Number.isFinite(y) && y >= 1970 && y <= 2100;
  });
  const reviews = all.filter((c) => c.data.primaryCategory === 'review');
  return yearEntries.map((c) => ({
    params: { year: String(c.data.year) },
    props: {
      conf: c,
      reviews: reviews.filter((r) => {
        if (r.data.year === c.data.year) return true;
        const tags = (r.data as any).tags ?? [];
        return tags.includes(String(c.data.year));
      }),
    },
  }));
}

const { conf, reviews } = Astro.props;
const { Content } = await render(conf);

const data: any = conf.data;
const title: string = data.title ?? '';
const subtitle: string | null = data.subtitle ?? null;
const theme: string | null = data.theme ?? null;
const dates: string | null = data.dates ?? null;
const venue: string | null = data.venue ?? null;
const venueUrl: string | null = data.venueUrl ?? null;
const country: string | null = data.country ?? null;
const topic: string | null = data.topic ?? null;
const year: number = data.year;
const isUpcoming: boolean = (data.primaryCategory ?? '') === 'upcoming' || year >= new Date().getFullYear();
const venuePhoto: string | null = data.venuePhoto ?? null;
const statusUpdates: Array<{ date?: string; text: string; href?: string }> = Array.isArray(data.statusUpdates) ? data.statusUpdates : [];
const draftProgramme: string | null = data.draftProgramme ?? null;
const programmePdf: string | null = data.programmePdf ?? null;
const recordings: Array<any> = Array.isArray(data.recordings) ? data.recordings : [];
const reviewsArr: Array<{ title: string; author: string; kind: 'brf' | 'brj' | 'external'; href: string }> = Array.isArray(data.reviews) ? data.reviews : [];
const speakers: Array<string> = Array.isArray(data.speakers) ? data.speakers : [];
const externalBookingUrl: string | null = data.externalBookingUrl ?? null;
const podcastSeasonUrl: string | null = data.podcastSeasonUrl ?? null;
const oldReviews = reviews;

function parseStartDate(d: string | null, fallbackYear: number): string | null {
  if (!d) return null;
  const monthMap: Record<string, number> = {
    january: 0, february: 1, march: 2, april: 3, may: 4, june: 5,
    july: 6, august: 7, september: 8, october: 9, november: 10, december: 11,
    jan: 0, feb: 1, mar: 2, apr: 3, jun: 5, jul: 6, aug: 7, sept: 8, sep: 8, oct: 9, nov: 10, dec: 11,
  };
  const m = d.match(/\b(January|February|March|April|May|June|July|August|September|October|November|December|Jan|Feb|Mar|Apr|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec)\b/i);
  if (!m) return null;
  const monthIdx = monthMap[m[1].toLowerCase()];
  const yearMatch = d.match(/\b((?:19|20)\d{2})\b/);
  const effectiveYear = yearMatch ? Number(yearMatch[1]) : fallbackYear;
  const dayMatch = d.match(/\b([0-3]?\d)\b/);
  if (monthIdx == null || !dayMatch) return null;
  const day = Number(dayMatch[1]);
  return new Date(Date.UTC(effectiveYear, monthIdx, day)).toISOString().slice(0, 10);
}
const startDate = parseStartDate(dates, year);

const pageUrl = `${site.origin}/conferences/${year}/`;
const eventLd = startDate
  ? {
      '@context': 'https://schema.org',
      '@type': 'Event',
      name: title,
      startDate,
      location: {
        '@type': 'Place',
        name: venue ?? '',
        address: country ?? '',
        url: venueUrl ?? undefined,
      },
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      description: subtitle ?? undefined,
      mainEntityOfPage: pageUrl,
    }
  : null;

const sectionLabels: Record<string, string> = {
  'status-updates': 'Status updates',
  'programme': 'Programme',
  'draft-programme': 'Draft programme',
  'planned-speeches': 'Planned speeches',
  'recordings': 'Recordings',
  'reviews': 'Reviews',
  'resources': 'Resources',
};
const sectionIds: string[] = [];
if (statusUpdates.length > 0) sectionIds.push('status-updates');
if (!isUpcoming && programmePdf) sectionIds.push('programme');
if (isUpcoming && draftProgramme) sectionIds.push('draft-programme');
if (isUpcoming && recordings.length > 0) sectionIds.push('planned-speeches');
if (!isUpcoming && recordings.length > 0) sectionIds.push('recordings');
if (!isUpcoming && reviewsArr.length + oldReviews.length > 0) sectionIds.push('reviews');
if (programmePdf || podcastSeasonUrl || speakers.length > 0) sectionIds.push('resources');

const allReviews: Array<{ title: string; author: string; kind: 'brf' | 'brj' | 'external'; href: string; date?: string }> = [
  ...reviewsArr,
  ...oldReviews.map((r: any) => ({
    title: r.data.title,
    author: (r.data.authors ?? ['Unknown'])[0] ?? 'Unknown',
    kind: 'brf' as const,
    href: `/conferences/${year}/review-${speakerSlug((r.data.authors ?? ['unknown'])[0] ?? 'unknown')}/`,
    date: r.data.datePublished,
  })),
];

const statusLabel = isUpcoming ? 'Upcoming' : 'Past';
---
<Site title={`${title} (${year}) — BRF`} description={subtitle ?? theme ?? title} jsonLd={eventLd}>
  <!-- Hero: venue photograph as backdrop, dark gradient overlay for legibility, with prominent Past/Upcoming indicator. -->
  <section class="relative overflow-hidden">
    {venuePhoto && (
      <img
        src={venuePhoto}
        alt={`${venue ?? title} venue photograph`}
        class="absolute inset-0 h-full w-full object-cover"
        loading="eager"
      />
    )}
    {!venuePhoto && (
      <div class="absolute inset-0 bg-gradient-to-br from-brand-ink via-brand-ink/90 to-brand-ink/70" aria-hidden="true" />
    )}
    <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-black/45 to-black/70" aria-hidden="true" />
    <div class="relative max-w-4xl mx-auto px-6 py-16 sm:py-24">
      <div class="text-white">
        <Breadcrumbs items={[
          { label: 'Home', href: '/' },
          { label: 'Conferences', href: '/conferences' },
          { label: statusLabel, href: undefined },
        ]} />
        <p class="mt-4 text-xs uppercase tracking-[0.18em] text-white/75">{year} BRF Conference</p>
        <h1 class="mt-2 font-serif text-4xl md:text-6xl text-white leading-tight text-balance">{theme ?? title}</h1>
        {subtitle && subtitle !== (theme ?? title) && (
          <p class="mt-3 text-lg text-white/85">{subtitle}</p>
        )}
        <p class="mt-5 text-sm text-white/80">
          {[dates, venue, country].filter(Boolean).join(' · ')}
        </p>
        <p class="mt-6">
          <span class={`inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wider ${isUpcoming ? 'bg-oxblood text-white' : 'bg-white/15 text-white ring-1 ring-white/30'}`}>
            {isUpcoming ? (
              <>
                <span aria-hidden="true" class="h-2 w-2 rounded-full bg-white animate-pulse" />
                Upcoming conference
              </>
            ) : (
              <>Past conference</>
            )}
          </span>
        </p>
      </div>
    </div>
  </section>

  <!-- Metadata strip with embedded TOC. One background colour so the TOC anchors visually into the metadata block. -->
  <section class="bg-brand-cream border-b border-brand-ink/10">
    <div class="max-w-4xl mx-auto px-6 py-10">
      <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-5 text-sm">
        <div>
          <dt class="uppercase text-muted tracking-wider text-xs">Year</dt>
          <dd class="mt-1 text-brand-ink font-medium">{year}</dd>
        </div>
        <div>
          <dt class="uppercase text-muted tracking-wider text-xs">Dates</dt>
          <dd class="mt-1 text-brand-ink">{dates ?? 'TBD'}</dd>
        </div>
        <div>
          <dt class="uppercase text-muted tracking-wider text-xs">Topic</dt>
          <dd class="mt-1 text-brand-ink">{topic ?? theme ?? 'TBD'}</dd>
        </div>
        {country && (
          <div>
            <dt class="uppercase text-muted tracking-wider text-xs">Location</dt>
            <dd class="mt-1 text-brand-ink">{country}</dd>
          </div>
        )}
        {venue && (
          <div>
            <dt class="uppercase text-muted tracking-wider text-xs">Venue</dt>
            <dd class="mt-1 text-brand-ink">
              {venueUrl ? (
                <a href={venueUrl} target="_blank" rel="noopener" class="hover:underline">{venue}</a>
              ) : (
                venue
              )}
            </dd>
          </div>
        )}
        <div>
          <dt class="uppercase text-muted tracking-wider text-xs">Speakers</dt>
          <dd class="mt-1 text-brand-ink">
            {speakers.length > 0 ? (
              <span class="flex flex-wrap gap-1.5">
                {speakers.map((s) => {
                  const sl = speakerSlug(s);
                  return (
                    <a href={`/author/${sl}/`} class="inline-flex items-center rounded-full border border-brand-ink/20 bg-white px-2.5 py-0.5 text-sm text-brand-ink hover:border-oxblood hover:text-oxblood">
                      {s}
                    </a>
                  );
                })}
              </span>
            ) : (
              <span class="text-muted">TBD</span>
            )}
          </dd>
        </div>
      </dl>

      {sectionIds.length >= 2 && (
        <nav aria-label="On this page" class="mt-8 pt-6 border-t border-brand-ink/10">
          <p class="text-xs uppercase tracking-wider text-muted">Sections</p>
          <ol class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm">
            {sectionIds.map((id) => (
              <li>
                <a href={`#${id}`} class="text-brand-ink hover:text-oxblood hover:underline">{sectionLabels[id]}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}
    </div>
  </section>

  {isUpcoming && externalBookingUrl && (
    <section class="bg-white border-b border-brand-ink/10">
      <div class="max-w-4xl mx-auto px-6 py-8">
        <a href={externalBookingUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-md bg-oxblood px-4 py-2.5 text-white hover:bg-oxblood/90">
          Book via brfconference.weebly.com ↗
        </a>
      </div>
    </section>
  )}

  {statusUpdates.length > 0 && (
    <section id="status-updates" class="bg-brand-parchment border-b border-brand-ink/10 scroll-mt-24">
      <div class="max-w-4xl mx-auto px-6 py-10">
        <h2 class="font-serif text-2xl text-brand-ink border-b border-brand-ink/20 pb-3">Status updates</h2>
        <ul class="mt-5 space-y-3">
          {statusUpdates
            .slice()
            .sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''))
            .map((u) => (
              <li class="text-sm text-brand-ink/85">
                <span class="font-medium">{u.text}</span>
                {u.href && (
                  <>
                    {' — '}
                    <a href={u.href} target="_blank" rel="noopener" class="text-brand-ink hover:text-oxblood hover:underline">link</a>
                  </>
                )}
              </li>
            ))}
        </ul>
      </div>
    </section>
  )}

  {!isUpcoming && programmePdf && (
    <section id="programme" class="bg-white border-b border-brand-ink/10 scroll-mt-24">
      <div class="max-w-4xl mx-auto px-6 py-10">
        <h2 class="font-serif text-2xl text-brand-ink border-b border-brand-ink/20 pb-3">Programme</h2>
        <p class="mt-4">
          <a href={programmePdf} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-md border border-brand-ink/20 px-4 py-2 text-sm text-brand-ink hover:bg-brand-cream">
            Final programme (PDF) ↗
          </a>
        </p>
      </div>
    </section>
  )}

  {isUpcoming && draftProgramme && (
    <section id="draft-programme" class="bg-white border-b border-brand-ink/10 scroll-mt-24">
      <div class="max-w-4xl mx-auto px-6 py-10">
        <h2 class="font-serif text-2xl text-brand-ink border-b border-brand-ink/20 pb-3">Draft programme</h2>
        <div class="prose prose-brand mt-4 max-w-none">
          <p>{draftProgramme}</p>
        </div>
      </div>
    </section>
  )}

  {isUpcoming && recordings.length > 0 && (
    <section id="planned-speeches" class="bg-brand-parchment border-t border-brand-ink/10 scroll-mt-24">
      <div class="max-w-4xl mx-auto px-6 py-10">
        <h2 class="font-serif text-2xl text-brand-ink border-b border-brand-ink/20 pb-3">Planned speeches</h2>
        <ul class="mt-5 space-y-3 text-brand-ink/85">
          {recordings.map((r: any) => (
            <li class="flex items-baseline justify-between gap-3">
              <span>
                <span class="text-xs uppercase tracking-wider text-muted">{r.number != null ? `Speech ${r.number}` : (r.kind === 'special-lecture' ? 'Special Lecture' : (r.kind === 'lords-day' ? "Lord's Day Sermon" : 'Speech'))}</span>
                <span class="ml-2">{r.title ?? 'Untitled'}</span>
              </span>
              <span class="text-sm text-muted">{r.speaker ?? 'TBD'}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {!isUpcoming && recordings.length > 0 && (
    <section id="recordings" class="scroll-mt-24">
      <ConferenceRecordings
        speeches={recordings}
        youtubePlaylistUrl={data.youtubePlaylistUrl ?? null}
      />
    </section>
  )}

  {!isUpcoming && allReviews.length > 0 && (
    <section id="reviews" class="bg-white border-t border-brand-ink/10 scroll-mt-24">
      <div class="max-w-4xl mx-auto px-6 py-12">
        <h2 class="font-serif text-2xl text-brand-ink border-b border-brand-ink/20 pb-3">Reviews</h2>
        <ul class="mt-6 divide-y divide-brand-ink/10">
          {allReviews.map((r) => (
            <li class="py-4">
              <p class="font-serif text-lg text-brand-ink leading-snug">
                <a href={r.href} class="hover:underline">{r.title}</a>
              </p>
              <p class="mt-1 text-sm text-brand-ink/65">
                <span>{r.author}</span>
                <span class="ml-2 inline-flex items-center rounded-full border border-brand-ink/20 px-2 py-0.5 text-xs text-brand-ink/75">
                  {r.kind === 'brf' ? 'BRF' : r.kind === 'brj' ? 'BRJ' : 'External'}
                </span>
                {r.date && <span class="ml-2 text-xs text-muted">{fmtDate(r.date)}</span>}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {(programmePdf || podcastSeasonUrl || speakers.length > 0) && (
    <section id="resources" class="bg-brand-cream border-t border-brand-ink/10 scroll-mt-24">
      <div class="max-w-4xl mx-auto px-6 py-10">
        <h2 class="font-serif text-2xl text-brand-ink border-b border-brand-ink/20 pb-3">Resources</h2>
        <ul class="mt-5 space-y-2 text-sm">
          {programmePdf && (
            <li>
              <a href={programmePdf} target="_blank" rel="noopener" class="text-brand-ink hover:text-oxblood hover:underline">Final programme (PDF) ↗</a>
            </li>
          )}
          {podcastSeasonUrl && (
            <li>
              <a href={podcastSeasonUrl} class="text-brand-ink hover:text-oxblood hover:underline">Podcast season for this conference</a>
            </li>
          )}
          {speakers.length > 0 && (
            <li>
              <a href={`/author/${speakerSlug(speakers[0])}/`} class="text-brand-ink hover:text-oxblood hover:underline">Speaker profiles and cross-references</a>
            </li>
          )}
        </ul>
      </div>
    </section>
  )}

  {conf.body && conf.body.trim().length > 0 && (
    <section class="bg-white border-t border-brand-ink/10">
      <div class="max-w-3xl mx-auto px-6 py-12 prose prose-brand">
        <Content />
      </div>
    </section>
  )}
</Site>
