---
import Site from '../../layouts/Site.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection, render } from 'astro:content';
import { fmtDate } from '../../lib/format';

export async function getStaticPaths() {
  const all = await getCollection('conferences');
  const reviews = all.filter(c => c.data.primaryCategory === 'review');
  return all.map(c => ({
    params: { year: String(c.data.year) },
    props: {
      conf: c,
      reviews: reviews.filter(r => r.data.year === c.data.year || r.data.tags?.includes(String(c.data.year))),
    },
  }));
}

const { conf, reviews } = Astro.props;
const { Content } = await render(conf);

const SITE = 'https://brf2.pages.dev';
const pageUrl = `${SITE}/conferences/${conf.data.year}/`;

/**
 * Convert conference `dates` strings ("3-10 August", "16-23 July", "9-16 July, 2022", "21-28 July")
 * into an ISO date for `startDate`. The conference `year` is used for the year.
 * Returns null if the input is null/empty or cannot be parsed safely.
 */
function parseStartDate(dates: string | null | undefined, fallbackYear: number | string | null | undefined): string | null {
  if (!dates) return null;
  const yearNum = Number(fallbackYear);
  const year = Number.isFinite(yearNum) ? yearNum : new Date().getFullYear();

  // Pull out "Month" word.
  const monthMatch = dates.match(/\b(January|February|March|April|May|June|July|August|September|October|November|December|Jan|Febri Febr Feb|Mar|Apr|May|Jun|Jul|Aug|Sept|Sep|Oct|Nov|Dec)\b/i);
  let monthIdx: number | null = null;
  if (monthMatch) {
    const m = monthMatch[1].toLowerCase();
    const monthMap: Record<string, number> = {
      january: 0, february: 1, march: 2, april: 3, may: 4, june: 5,
      july: 6, august: 7, september: 8, october: 9, november: 10, december: 11,
      jan: 0, feb: 1, mar: 2, apr: 3, jun: 5, jul: 6, aug: 7, sept: 8, sep: 8, oct: 9, nov: 10, dec: 11,
    };
    monthIdx = monthMap[m] ?? null;
  }

  // Pull out an explicit year if present.
  const yearMatch = dates.match(/\b((?:19|20)\d{2})\b/);
  const effectiveYear = yearMatch ? Number(yearMatch[1]) : year;

  // Pull out the first day number (1-31).
  const dayMatch = dates.match(/\b([0-3]?\d)\b/);

  if (monthIdx == null || !dayMatch) return null;
  const day = Number(dayMatch[1]);
  if (!Number.isFinite(day) || day < 1 || day > 31) return null;

  // Use UTC to avoid TZ drift; emit date-only ISO.
  return new Date(Date.UTC(effectiveYear, monthIdx, day)).toISOString().slice(0, 10);
}

const startDate = parseStartDate(conf.data.dates, conf.data.year);

const venue = conf.data.venue ?? null;

const eventLd = startDate ? {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: conf.data.title,
  startDate,
  location: {
    '@type': 'Place',
    name: venue ?? '',
    address: '',
  },
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  mainEntityOfPage: pageUrl,
} : null;
---
<Site title={`${conf.data.title} (${conf.data.year}) — BRF`} jsonLd={eventLd}>
  <section class="bg-brand-cream border-b border-brand-ink/10">
    <div class="max-w-4xl mx-auto px-6 py-12">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Conferences', href: '/conferences' },
        { label: String(conf.data.year) },
      ]} />
      <p class="mt-3 text-xs uppercase tracking-wider text-muted">{conf.data.year} Conference</p>
      <h1 class="mt-2 font-serif text-4xl md:text-5xl text-brand-ink leading-tight">{conf.data.title}</h1>
      {conf.data.subtitle && <p class="mt-3 text-lg text-brand-ink/80">{conf.data.subtitle}</p>}
      <dl class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
        {conf.data.dates && (
          <div>
            <dt class="uppercase text-muted tracking-wider text-xs">Dates</dt>
            <dd class="mt-1 text-brand-ink">{conf.data.dates}</dd>
          </div>
        )}
        {conf.data.venue && (
          <div>
            <dt class="uppercase text-muted tracking-wider text-xs">Venue</dt>
            <dd class="mt-1 text-brand-ink">{conf.data.venue}</dd>
          </div>
        )}
        {conf.data.theme && (
          <div>
            <dt class="uppercase text-muted tracking-wider text-xs">Theme</dt>
            <dd class="mt-1 text-brand-ink">{conf.data.theme}</dd>
          </div>
        )}
      </dl>
    </div>
  </section>

  {(conf.data.description || (conf.body && conf.body.trim().length > 0)) && (
    <section class="bg-white">
      <div class="max-w-3xl mx-auto px-6 py-12">
        {conf.data.description && (
          <p class="text-lg text-brand-ink/85 leading-relaxed">{conf.data.description}</p>
        )}
        {conf.body && conf.body.trim().length > 0 && (
          <div class="prose prose-brand mt-8">
            <Content />
          </div>
        )}
      </div>
    </section>
  )}

  {reviews && reviews.length > 0 && (
    <section class="bg-brand-parchment border-t border-brand-ink/10">
      <div class="max-w-4xl mx-auto px-6 py-12">
        <h2 class="font-serif text-2xl text-brand-ink border-b border-brand-ink/20 pb-3">Reviews</h2>
        <ul class="mt-6 divide-y divide-brand-ink/10">
          {reviews.map(r => (
            <li class="py-4">
              <p class="font-medium text-brand-ink">{r.data.title}</p>
              <p class="mt-1 text-sm text-brand-ink/65">
                By {r.data.authors.join(', ')} · {fmtDate(r.data.datePublished)}
              </p>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-xs text-muted">
          Review pages are not yet routed; see Phase 2b.
        </p>
      </div>
    </section>
  )}
</Site>