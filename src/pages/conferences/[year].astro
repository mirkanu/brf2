---
import Site from "../../layouts/Site.astro";
import ArticleToc from "../../components/ArticleToc.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { getCollection } from "astro:content";
import { speakerSlug, isTbdSpeaker } from "../../lib/speakers";

export async function getStaticPaths() {
  const confs = await getCollection("conferences");
  // Canonical conferences have primaryCategory in {past, upcoming} AND a unique year.
  const seen = new Map<number, any>();
  for (const c of confs) {
    const cat = (c.data as any).primaryCategory;
    if (cat !== "past" && cat !== "upcoming") continue;
    const y = (c.data as any).year;
    if (typeof y !== "number") continue;
    if (seen.has(y)) {
      throw new Error(`Duplicate conference year ${y}: ${seen.get(y).id} and ${c.id}`);
    }
    seen.set(y, c);
  }
  return [...seen.values()].map((c) => ({
    params: { year: String((c.data as any).year) },
    props: { entry: c },
  }));
}

const { entry: conference } = Astro.props as { entry: any };
if (!conference) {
  return Astro.redirect("/conferences/");
}
const d = conference.data;

const today = new Date();
const cy = today.getFullYear();
const isCurrentYear = d.year === cy;
const hasEnd = !!(d.dates && d.dates.trim() && d.dates.trim().toLowerCase() !== "tbd");
const upcoming = d.year > cy || (isCurrentYear && hasEnd);
const STATUS_LABEL = upcoming ? "UPCOMING CONFERENCE" : "PAST CONFERENCE";

const hasProgramme = !!d.programmePdf;
const hasRecordings = (d.recordings ?? []).length > 0;
const hasReviews = (d.reviews ?? []).length > 0;

const headings: { depth: number; slug: string; text: string }[] = [];
if (hasProgramme) headings.push({ depth: 2, slug: "programme", text: "Programme" });
if (hasRecordings) headings.push({ depth: 2, slug: "recordings", text: "Recordings" });
if (hasReviews) headings.push({ depth: 2, slug: "reviews", text: "Reviews" });
// Resources section suppressed (see template).

const venuePhotoUrl = d.venuePhoto ?? null;
// Prev/Next navigation: walk the conferences collection by year.
const pageTitle = `${d.title} | ${d.year} BRF Conference`;
const _allConfs = await getCollection("conferences");
const _yearsWithPages = _allConfs
  .map((c: any) => c.data?.year)
  .filter((y: any): y is number => typeof y === "number");
const _sortedYears = Array.from(new Set(_yearsWithPages)).sort((a: number, b: number) => a - b);
const _idx = _sortedYears.indexOf(d.year);
const _prevYear = _idx > 0 ? _sortedYears[_idx - 1] : null;
const _nextYear = _idx >= 0 && _idx < _sortedYears.length - 1 ? _sortedYears[_idx + 1] : null;
const _findConf = (y: number) => _allConfs.find((c: any) => c.data?.year === y);
const _prev = _prevYear != null ? _findConf(_prevYear) : null;
const _next = _nextYear != null ? _findConf(_nextYear) : null;
const _prevTitle = _prev?.data?.title ?? (_prev ? `${_prevYear} BRF Conference` : null);
const _nextTitle = _next?.data?.title ?? (_next ? `${_nextYear} BRF Conference` : null);

const description = (d.title ?? "").replace(/<[^>]+>/g, "").trim();

const speakers = (d.speakers ?? []).map((s: string) => s.trim()).filter(Boolean);

const KIND_ORDER = ["special-lecture", "lords-day", "speech", "outro"] as const;
const KIND_HEADINGS: Record<string, string> = {
  "special-lecture": "Special Lectures",
  "lords-day": "Lord's Day Sermons",
  "speech": "Speeches",
  "outro": "Conference Closing",
};
const KIND_BADGE: Record<string, string> = {
  "speech": "Speech",
  "lords-day": "Sermon",
  "special-lecture": "Lecture",
  "outro": "Outro",
};

interface Group { kind: string; title: string; items: any[] }
function groupRecordings(recs: any[]): Group[] {
  const buckets = new Map<string, any[]>();
  for (const r of recs) {
    const k = KIND_ORDER.includes(r.kind) ? r.kind : (r.kind ?? "speech");
    if (!buckets.has(k)) buckets.set(k, []);
    buckets.get(k)!.push(r);
  }
  return KIND_ORDER.filter(k => buckets.has(k)).map(k => ({
    kind: k,
    title: KIND_HEADINGS[k],
    items: buckets.get(k)!,
  }));
}
const recordingGroups = groupRecordings(d.recordings ?? []);

const AudioIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-3.5"><path d="M12 3a9 9 0 0 0-9 9v5a3 3 0 0 0 3 3h2a1 1 0 0 0 1-1v-7a1 1 0 0 0-1-1H5.5a6.5 6.5 0 0 1 13 0H16a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h2a3 3 0 0 0 3-3v-5a9 9 0 0 0-9-9Z"/></svg>`;
const YouTubeIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-3.5"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.76-1.76C18.27 5 12 5 12 5s-6.27 0-7.84.44A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.76 1.76C5.73 19 12 19 12 19s6.27 0 7.84-.44a2.5 2.5 0 0 0 1.76-1.76A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8ZM10 15V9l5.2 3L10 15Z"/></svg>`;
---
<Site title={pageTitle} description={description} ogImageUrl={venuePhotoUrl ?? undefined}>
  <section
    class="relative isolate overflow-hidden text-white"
    style={venuePhotoUrl
      ? `background-image: linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.55)), url('${venuePhotoUrl}'); background-size: cover; background-position: center; min-height: 22rem;`
      : "background-color: #7a6f57; min-height: 22rem;"}
  >
    <div class="relative mx-auto max-w-5xl px-5 py-16 sm:px-6 sm:py-20">
      <div class="mb-6 flex flex-wrap items-center gap-2 text-xs uppercase tracking-wider">
        <span class={upcoming ? "rounded-full bg-emerald-500/95 px-3 py-1 font-semibold text-white" : "rounded-full bg-white/15 px-3 py-1 font-semibold text-white ring-1 ring-white/30"}>
          {STATUS_LABEL}
        </span>
      </div>
      <Breadcrumbs
        items={[
          { label: "Home", href: "/" },
          { label: "Conferences", href: "/conferences/" },
          { label: String(d.year) },
        ]}
        tone="dark"
        class="text-white/90"
      />
      <p class="mt-8 text-xs font-semibold uppercase tracking-[0.2em] text-white/80">BRF Conference</p>
      <h1 class="mt-3 font-serif text-4xl font-semibold leading-tight sm:text-5xl lg:text-6xl">
        {d.title ?? `${d.year} BRF Conference`}
      </h1>
      {d.subtitle && <p class="mt-3 text-lg text-white/85">{d.subtitle}</p>}
    </div>
  </section>

  <section class="bg-white">
    <div class={"mx-auto px-5 py-10 sm:px-6 sm:py-12 " + (headings.length > 0 ? "lg:grid lg:max-w-5xl lg:grid-cols-[minmax(0,1fr)_14rem] lg:gap-10" : "max-w-5xl")}>
      <div class="min-w-0">
        <dl class="grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-3">
          <div>
            <dt class="text-xs uppercase tracking-wider text-brand-muted">Year</dt>
            <dd class="mt-1 text-sm font-medium text-brand-ink">{d.year}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wider text-brand-muted">Dates</dt>
            <dd class="mt-1 text-sm font-medium text-brand-ink">{d.dates ?? "TBD"}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wider text-brand-muted">Topic</dt>
            <dd class="mt-1 text-sm font-medium text-brand-ink">{d.topic ?? "TBD"}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wider text-brand-muted">Location</dt>
            <dd class="mt-1 text-sm font-medium text-brand-ink">{d.country ?? "TBD"}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wider text-brand-muted">Venue</dt>
            <dd class="mt-1 text-sm font-medium text-brand-ink">
              {d.venueUrl ? (
                <a href={d.venueUrl} target="_blank" rel="noopener" class="underline decoration-brand-ink/30 underline-offset-2 hover:decoration-brand-ink">{d.venue ?? "TBD"}</a>
              ) : (
                d.venue ?? "TBD"
              )}
            </dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wider text-brand-muted">Speakers</dt>
            <dd class="mt-1 flex flex-wrap gap-1.5">
              {speakers.length > 0 ? speakers.map((s: string) => (
                isTbdSpeaker(s) ? (
                  <span class="inline-flex items-center rounded-full border border-brand-ink/30 bg-white px-2.5 py-0.5 text-xs font-medium text-brand-ink">TBD</span>
                ) : (
                  <a href={`/author/${speakerSlug(s)}/`} class="inline-flex items-center rounded-full border border-brand-ink/30 bg-white px-2.5 py-0.5 text-xs font-medium text-brand-ink hover:border-brand-ink/60">{s}</a>
                )
              )) : <span class="text-sm font-medium text-brand-ink">TBD</span>}
            </dd>
          </div>
        </dl>

        {hasProgramme && (
          <div class="mt-10">
            <h2 id="programme" class="font-serif text-2xl font-semibold text-brand-ink">Programme</h2>
            <div class="mt-4 border-t border-brand-ink/15 pt-4">
              <a href={d.programmePdf} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-full border border-brand-ink/30 bg-white px-3 py-1.5 text-sm font-medium text-brand-ink hover:border-brand-ink/60">
                Final programme (PDF) ↗
              </a>
            </div>
          </div>
        )}
        {/* Programme section is hidden when no PDF is available. */}

        {hasRecordings && (
          <div id="recordings" class="mt-12">
            <h2 id="recordings" class="font-serif text-2xl font-semibold text-brand-ink">Recordings</h2>
            <div class="mt-4 border-t border-brand-ink/15 pt-4 space-y-8">
              {d.youtubePlaylistUrl && (
                <p class="text-sm">
                  <a href={d.youtubePlaylistUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1 font-medium text-brand-ink underline decoration-brand-ink/30 underline-offset-2 hover:decoration-brand-ink">
                    Full YouTube playlist ↗
                  </a>
                </p>
              )}
              {recordingGroups.map((g) => {
                const isSpeech = g.kind === "speech";
                return (
                <section aria-labelledby={`grp-${g.kind}`} class="space-y-3">
                  <header class="flex items-baseline justify-between gap-3 border-b border-brand-ink/15 pb-2">
                    <h3 id={`grp-${g.kind}`} class="font-serif text-lg font-semibold text-brand-ink">{g.title}</h3>
                    <span class="text-xs uppercase tracking-wider text-brand-muted">{g.items.length}</span>
                  </header>
                  <ol class={isSpeech ? "space-y-3" : "space-y-3"}>
                    {g.items.map((r: any, idx: number) => {
                      const badgeLabel = isSpeech && r.number ? `Speech ${r.number}` : KIND_BADGE[r.kind] ?? r.label ?? "Recording";
                      const hasMp3 = !!r.mp3Url;
                      const hasYt = !!r.youtubeId;
                      return (
                        <li class="rounded-md border border-brand-ink/15 bg-brand-cream/40 px-4 py-3">
                          <details class="group">
                            <summary class="cursor-pointer list-none">
                              <div class="flex items-start gap-3">
                                {isSpeech && r.number && (
                                  <span aria-hidden="true" class="mt-0.5 inline-flex size-7 shrink-0 items-center justify-center rounded-full bg-brand-ink text-xs font-semibold text-brand-cream">{r.number}</span>
                                )}
                                <div class="min-w-0 flex-1">
                                  <p class="text-xs uppercase tracking-wider text-brand-muted">{badgeLabel}</p>
                                  <p class="mt-0.5 font-serif text-lg font-semibold text-brand-ink">{r.title}</p>
                                  {r.speaker && (
                                    <p class="mt-0.5 text-sm text-brand-muted">
                                      {isTbdSpeaker(r.speaker) ? r.speaker : (
                                        <a href={`/author/${speakerSlug(r.speaker)}/`} class="underline decoration-brand-ink/30 underline-offset-2 hover:decoration-brand-ink">{r.speaker}</a>
                                      )}
                                    </p>
                                  )}
                                </div>
                                <div class="flex shrink-0 items-center gap-1.5 pt-1 text-brand-muted">
                                  {hasMp3 && <span title="Audio" aria-label="Audio available"><Fragment set:html={AudioIcon} /></span>}
                                  {hasYt && <span title="Video" aria-label="Video available"><Fragment set:html={YouTubeIcon} /></span>}
                                </div>
                              </div>
                            </summary>
                            <div class="mt-3 space-y-4 border-t border-brand-ink/10 pt-3">
                              {hasMp3 && (
                                <div>
                                  <p class="mb-1.5 inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-brand-ink">
                                    <Fragment set:html={AudioIcon} /> Listen
                                  </p>
                                  <audio controls preload="none" class="w-full">
                                    <source src={r.mp3Url} type="audio/mpeg" />
                                  </audio>
                                </div>
                              )}
                              {hasMp3 && hasYt && (
                                <p class="my-1 text-center text-xs font-semibold uppercase tracking-[0.2em] text-brand-muted">— OR —</p>
                              )}
                              {hasYt && (
                                <div>
                                  <p class="mb-1.5 inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-brand-ink">
                                    <Fragment set:html={YouTubeIcon} /> Watch
                                  </p>
                                  <div class="aspect-video overflow-hidden rounded">
                                    <iframe
                                      src={`https://www.youtube.com/embed/${r.youtubeId}`}
                                      title={r.title}
                                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                      allowfullscreen
                                      class="h-full w-full"
                                    ></iframe>
                                  </div>
                                </div>
                              )}
                              {!hasMp3 && !hasYt && (
                                <p class="text-sm text-brand-muted">Recording not yet available.</p>
                              )}
                            </div>
                          </details>
                        </li>
                      );
                    })}
                  </ol>
                </section>
                );
              })}
            </div>
          </div>
        )}

        {hasReviews && (
          <div class="mt-12">
            <h2 id="reviews" class="font-serif text-2xl font-semibold text-brand-ink">Reviews</h2>
            <div class="mt-4 space-y-4 border-t border-brand-ink/15 pt-4">
              {(d.reviews ?? []).map((r: any) => {
                const author = (r.author ?? r.title ?? "Reviewer").toString();
                const authorSlug = author.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
                const href = r.url ?? `/conferences/${d.year}/review-${authorSlug}/`;
                return (
                  <article class="border-b border-brand-ink/10 pb-4 last:border-b-0">
                    <a href={href} class="font-serif text-lg font-semibold text-brand-ink underline decoration-brand-ink/30 underline-offset-2 hover:decoration-brand-ink">{r.title}</a>
                    <p class="mt-1 text-sm text-brand-muted">{author}{r.host ? <span class="ml-2 inline-block rounded-full border border-brand-ink/30 bg-white px-2 py-0.5 text-[10px] font-medium uppercase tracking-wider text-brand-ink">{r.host}</span> : null}</p>
                  </article>
                );
              })}
            </div>
          </div>
        )}

        {/* The Resources section is intentionally suppressed: every item it
            contained (programme PDF, speakers list) duplicates content
            already shown in the Programme section and the Speakers metadata row.
            Resurface here only when a future migration adds a link that is
            genuinely unique to this conference (e.g. external archive). */}
      </div>

      {headings.length > 0 && (
        <aside class="hidden lg:block">
          <div class="sticky top-24">
            <ArticleToc headings={headings} />
          </div>
        </aside>
      )}
      {(_prev || _next) && (
        <nav aria-label="Conference pagination" class="mt-12 grid max-w-5xl gap-6 border-t border-brand-ink/15 pt-10 sm:grid-cols-2">
          {_prev ? (
            <a href={`/conferences/${_prevYear}/`} class="group flex flex-col rounded-lg border border-brand-ink/10 bg-white p-5 transition hover:border-brand-ink/30">
              <span class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-muted">← Previous conference</span>
              <span class="mt-2 font-serif text-lg font-semibold text-brand-ink group-hover:underline">{_prevTitle}</span>
              <span class="mt-1 text-xs text-brand-muted">{_prevYear}</span>
            </a>
          ) : <span aria-hidden="true" />}
          {_next ? (
            <a href={`/conferences/${_nextYear}/`} class="group flex flex-col rounded-lg border border-brand-ink/10 bg-white p-5 text-right transition hover:border-brand-ink/30 sm:items-end">
              <span class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-muted">Next conference →</span>
              <span class="mt-2 font-serif text-lg font-semibold text-brand-ink group-hover:underline">{_nextTitle}</span>
              <span class="mt-1 text-xs text-brand-muted">{_nextYear}</span>
            </a>
          ) : <span aria-hidden="true" />}
        </nav>
      )}
    </div>
  </section>
          <script>
        // Exclusive-open recording panels: opening one closes any other
        // open <details> and pauses its audio. Collapsing the current panel
        // also pauses its audio.
        (function () {
          const root = document.getElementById("recordings");
          if (!root) return;
          const panels = Array.from(root.querySelectorAll("details"));
          panels.forEach((panel) => {
            panel.addEventListener("toggle", () => {
              if (panel.open) {
                // close siblings + pause their audio
                panels.forEach((other) => {
                  if (other !== panel && other.open) {
                    other.open = false;
                  }
                  const a = other.querySelector("audio");
                  if (a && a !== panel.querySelector("audio")) {
                    try { a.pause(); } catch (_) { /* noop */ }
                  }
                });
              } else {
                // collapsing the current panel: pause its audio
                const a = panel.querySelector("audio");
                if (a) {
                  try { a.pause(); } catch (_) { /* noop */ }
                }
              }
            });
          });
        })();
      </script>
    </Site>
