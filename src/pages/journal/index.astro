---
import Site from '../../layouts/Site.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const issues = await getCollection('journalIssues');
const articles = await getCollection('journal');

// Count articles per issue
const countByIssue = new Map<number, number>();
for (const a of articles) {
  if (a.data.section !== 'journal-article') continue;
  const n = a.data.issueNumber;
  if (n == null) continue;
  countByIssue.set(n, (countByIssue.get(n) ?? 0) + 1);
}

// Sort newest first
const sorted = issues.slice().sort((a, b) => {
  // Prefer issueDate desc, then issueNumber desc
  const ad = a.data.issueDate ?? '';
  const bd = b.data.issueDate ?? '';
  if (ad !== bd) return bd.localeCompare(ad);
  return b.data.issueNumber - a.data.issueNumber;
});
---

<Site title="The British Reformed Journal — BRF">
  <section class="bg-brand-cream border-b border-brand-ink/10">
    <div class="max-w-5xl mx-auto px-6 py-12">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Journal' }]} />
      <h1 class="mt-4 font-serif text-4xl md:text-5xl text-brand-ink">The British Reformed Journal</h1>
      <p class="mt-3 max-w-2xl text-brand-ink/75">
        Articles, reviews, and editorials on the Reformed faith, history, theology, and practice —
        edited by Rev. Dr. R. S. Allan and published by the British Reformed Fellowship.
      </p>
      <p class="mt-3 text-sm text-brand-ink/60">{sorted.length} issues in the archive.</p>
    </div>
  </section>

  <section class="bg-white">
    <div class="max-w-5xl mx-auto px-6 py-12">
      <h2 class="font-serif text-2xl text-brand-ink border-b border-brand-ink/20 pb-3">All issues</h2>
      <ul class="mt-6 grid grid-cols-2 gap-6 sm:grid-cols-3 md:grid-cols-4">
        {sorted.map((issue) => {
          const n = issue.data.issueNumber;
          const url = `/journal/issue/issue-${String(n).padStart(2, '0')}`;
          const title = issue.data.issueDate ?? `Issue ${n}`;
          const count = countByIssue.get(n) ?? 0;
          return (
            <li>
              <a href={url} class="group block">
                {issue.data.coverImage && (
                  <img
                    src={issue.data.coverImage}
                    alt={`${title} cover`}
                    width="320"
                    height="420"
                    class="w-full rounded-sm border border-brand-ink/15 shadow-sm transition group-hover:shadow"
                    loading="lazy"
                  />
                )}
                <p class="mt-2 font-serif text-lg text-brand-ink leading-tight group-hover:underline">{title}</p>
                <p class="mt-0.5 text-xs text-brand-ink/60 tabular-nums">
                  {count} {count === 1 ? 'article' : 'articles'}
                </p>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</Site>