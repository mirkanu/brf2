---
import Site from '../../layouts/Site.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const PER_PAGE = 20;
const all = await getCollection('journal');
const sorted = all
  .filter(j => j.data.datePublished)
  .sort((a, b) => b.data.datePublished.localeCompare(a.data.datePublished));

// Show first page on /journal (sorted by date desc, page 1)
const page1 = sorted.slice(0, PER_PAGE);
const totalPages = Math.max(1, Math.ceil(sorted.length / PER_PAGE));

// Group by category for the category cloud (top categories only)
const counts = new Map<string, number>();
for (const j of all) (j.data.rawCategories || []).forEach((c: string) => counts.set(c, (counts.get(c) || 0) + 1));
const topCats = [...counts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 20);
---
<Site title="The British Reformed Journal — BRF">
  <section class="bg-brand-cream border-b border-brand-ink/10">
    <div class="max-w-5xl mx-auto px-6 py-12">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Journal' }]} />
      <h1 class="mt-4 font-serif text-4xl md:text-5xl text-brand-ink">The British Reformed Journal</h1>
      <p class="mt-3 max-w-2xl text-brand-ink/75">
        Articles, reviews, and editorials on the Reformed faith, history, theology, and practice —
        edited by Rev. Dr. R. S. Allan and published by the British Reformed Fellowship.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="max-w-5xl mx-auto px-6 py-12">
      <h2 class="font-serif text-2xl text-brand-ink border-b border-brand-ink/20 pb-3">Latest articles</h2>
      <ul class="mt-8 grid gap-6 md:grid-cols-2">
        {page1.map(item => <ArticleCard item={item} />)}
      </ul>
      {totalPages > 1 && (
        <nav class="mt-10 flex items-center justify-between border-t border-brand-ink/15 pt-6">
          <span />
          <p class="text-sm text-brand-ink/60">Page 1 of {totalPages}</p>
          <a href="/journal/2" class="text-brand-ink hover:underline">Next →</a>
        </nav>
      )}
    </div>
  </section>

  {topCats.length > 0 && (
    <section class="bg-brand-parchment">
      <div class="max-w-5xl mx-auto px-6 py-12">
        <h2 class="font-serif text-2xl text-brand-ink border-b border-brand-ink/20 pb-3">Browse by category</h2>
        <ul class="mt-6 flex flex-wrap gap-2">
          {topCats.map(([cat, n]) => (
            <li>
              <a
                href={`/journal/category/${cat}`}
                class="inline-block rounded-full border border-brand-ink/25 bg-white px-3 py-1 text-sm text-brand-ink hover:bg-brand-ink/5"
              >
                {cat.replace(/-/g, ' ')} <span class="ml-1 text-brand-ink/55">({n})</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Site>
