---
import Site from '../../layouts/Site.astro';
import ArticleBody from '../../components/ArticleBody.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('journal');
  const slugFor = (a: any) => {
    const legacy = a.data?.legacyPath as string | undefined;
    if (legacy && legacy.startsWith('/journal/articles/')) {
      return 'articles/' + legacy.slice('/journal/articles/'.length);
    }
    if (legacy && legacy.startsWith('/journal/')) {
      return legacy.slice('/journal/'.length);
    }
    return a.id.replace(/\.json$/, '');
  };
  return articles.map((a) => ({
    params: { slug: slugFor(a) },
    props: { article: a },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
---
<Site title={`${article.data.title} — British Reformed Journal`} description={(article.data as any).summary ?? article.data.title}>
  <ArticleBody entry={article}>
    <Content />
  </ArticleBody>
</Site>
