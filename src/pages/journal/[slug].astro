---
import Site from '../../layouts/Site.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((a) => ({ params: { slug: a.id }, props: { article: a } }));
}

const { article } = Astro.props;
const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Site title={`${article.data.title} — British Reformed Journal`} description={article.data.summary}>
  <article class="mx-auto max-w-3xl px-6 py-12 font-serif">
    <p class="font-sans text-xs uppercase tracking-[0.22em] text-oxblood">{article.data.issue}</p>
    <h1 class="text-4xl md:text-5xl leading-tight mt-3 tracking-tight text-balance">{article.data.title}</h1>
    <p class="font-sans text-sm text-muted mt-4">{article.data.author} · {fmtDate(article.data.published)}</p>
    <p class="text-lg text-ink/85 mt-8 leading-relaxed">{article.data.summary}</p>

    <div class="border-t border-rule mt-10 pt-8 font-sans text-sm flex flex-wrap gap-3">
      <a href={article.data.pdf} class="bg-oxblood text-paper px-5 py-2.5 rounded-sm no-underline hover:bg-[#5e1717]">Read the full PDF</a>
      <a href="/journal" class="border border-rule px-5 py-2.5 rounded-sm no-underline hover:bg-[#f3eee2]">Back to the journal</a>
    </div>

    {article.data.tags.length > 0 && (
      <div class="mt-10 flex flex-wrap gap-2 font-sans text-xs">
        {article.data.tags.map((t) => (
          <span class="border border-rule px-2.5 py-1 rounded-sm text-muted">{t}</span>
        ))}
      </div>
    )}
  </article>
</Site>
