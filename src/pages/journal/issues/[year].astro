---
import Site from '../../../layouts/Site.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allArticles = await getCollection('journal');
  const years = new Map<string, number>();
  for (const entry of allArticles) {
    if (entry.data.section !== 'journal-article') continue;
    const year = entry.data.issueYear;
    if (year) years.set(String(year), (years.get(String(year)) ?? 0) + 1);
  }
  return Array.from(years.keys()).sort((a, b) => Number(b) - Number(a)).map((year) => ({ params: { year } }));
}

const { year } = Astro.params;
const allArticles = await getCollection('journal');
const articles = allArticles
  .filter((entry) => entry.data.section === 'journal-article' && String(entry.data.issueYear) === year)
  .sort((a, b) => Number(b.data.issueNumber ?? 0) - Number(a.data.issueNumber ?? 0) ||
    new Date(b.data.datePublished).getTime() - new Date(a.data.datePublished).getTime());
---
<Site title={`Issue ${year}`} description={`British Reformed Journal issues for ${year}.`}>
  <div class="border-b border-[var(--border)] bg-[var(--surface-1)]">
    <div class="mx-auto max-w-6xl px-6 py-12">
      <p class="text-sm uppercase tracking-widest text-[var(--accent)]">BRJ Issues</p>
      <h1 class="font-serif text-4xl md:text-5xl leading-[1.05] tracking-tight">{year}</h1>
      <p class="mt-3 text-[var(--muted)] max-w-2xl">
        {articles.length} {articles.length === 1 ? 'article' : 'articles'} published in the British Reformed Journal in {year}.
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-6 py-12">
    {articles.length === 0 ? (
      <p class="text-[var(--muted)]">No articles found for {year}.</p>
    ) : (
      <ul class="grid grid-cols-1 gap-x-8 gap-y-10 md:grid-cols-2 lg:grid-cols-3">
        {articles.map((entry) => <ArticleCard article={entry} />)}
      </ul>
    )}
  </div>
</Site>
