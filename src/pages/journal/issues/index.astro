---
import Site from '../../../layouts/Site.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('journal');
const issuesByYear = new Map<number, { count: number; issues: Set<string | undefined> }>();
for (const entry of allArticles) {
  if (entry.data.section !== 'journal-article') continue;
  const year = entry.data.issueYear;
  if (!year) continue;
  const slot = issuesByYear.get(year) ?? { count: 0, issues: new Set() };
  slot.count += 1;
  slot.issues.add(entry.data.issueNumber == null ? undefined : String(entry.data.issueNumber));
  issuesByYear.set(year, slot);
}

const years = Array.from(issuesByYear.entries())
  .sort(([a], [b]) => b - a)
  .map(([year, info]) => ({ year, count: info.count, issues: Array.from(info.issues).sort((x, y) => Number(y ?? 0) - Number(x ?? 0)) }));
---
<Site title="Issues" description="Browse the British Reformed Journal by issue year.">
  <div class="border-b border-[var(--border)] bg-[var(--surface-1)]">
    <div class="mx-auto max-w-6xl px-6 py-12">
      <h1 class="font-serif text-4xl md:text-5xl leading-[1.05] tracking-tight">Issues by year</h1>
      <p class="mt-3 text-[var(--muted)] max-w-2xl">
        Every issue of the British Reformed Journal since {years.at(-1)?.year ?? '—'}.
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="space-y-8">
      {years.map(({ year, count, issues }) => (
        <div class="grid grid-cols-1 gap-6 border-b border-[var(--border)] pb-8 md:grid-cols-[10rem_1fr]">
          <div>
            <a href={`/journal/issues/${year}`} class="font-serif text-3xl tracking-tight text-[var(--foreground)] hover:text-[var(--accent)]">{year}</a>
          </div>
          <div class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
            {issues.map((issueNumber) => (
              <a href={`/journal/issues/${year}`} class="text-[var(--muted)] hover:text-[var(--accent)] tabular-nums">
                Issue {String(issueNumber).padStart(2, '0')}
              </a>
            ))}
            <span class="ml-auto text-xs uppercase tracking-widest text-[var(--muted)]">{count} articles</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</Site>
