---
import Site from '../../../../layouts/Site.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import ScriptureHover from '../../../../components/ScriptureHover.astro';
import FootnoteHover from '../../../../components/FootnoteHover.astro';
import ArticleToc from '../../../../components/ArticleToc.astro';
import { getCollection, render } from 'astro:content';
import { slugify } from '../../../../lib/format';
import { decodeEntities } from '../../../../lib/text';

export const prerender = true;

export async function getStaticPaths() {
  const articles = await getCollection('journal');
  const issues = await getCollection('journalIssues');
  const issueByNumber = new Map(issues.map((i) => [i.data.issueNumber, i]));

  const paths: Array<{ params: { issue: string; slug: string }; props: { article: typeof articles[number]; issueNum: number; issue?: typeof issues[number] } }> = [];

  for (const article of articles) {
    if (article.data.section !== 'journal-article') continue;
    const issueNum = article.data.issueNumber;
    if (issueNum == null) continue;
    const idSlug = article.id.replace(/\.json$/, '');
    // Slug source = existing filename slug minus "article-" prefix
    const slug = idSlug.replace(/^article-/, '');
    const issue = issueByNumber.get(issueNum);
    if (!issue) continue;
    paths.push({
      params: { issue: `issue-${String(issueNum).padStart(2, '0')}`, slug },
      props: { article, issueNum, issue },
    });
  }

  return paths;
}

const { article, issue, issueNum } = Astro.props;

// Look up matching body from `journalBodies` collection; if none, render nothing.
const articleId = article.id.replace(/\.json$/, '');
const bodies = await getCollection('journalBodies');
const body = bodies.find((b) => b.id === `${articleId}.md` || b.id === articleId);
const renderResult = body ? await render(body) : { Content: () => null, headings: [] };
const Content = renderResult.Content;
const allHeadings = renderResult.headings ?? [];
const headings = allHeadings.filter((h) => h.depth === 2 || h.depth === 3);

const { title: rawTitle, datePublished, authors } = article.data;
const title = decodeEntities(rawTitle);
const authorNames = (authors ?? []).filter((s) => s && s.trim().length > 0);

// Reading time: average adult reads ~225 wpm on long-form prose.
// wordCount derived from the raw markdown body if available.
const wordCount = body ? (body.body ?? '').trim().split(/\s+/).filter(Boolean).length : 0;
const readingMinutes = Math.max(1, Math.round(wordCount / 225));

// Display title: [issueDate] if provided, otherwise "Issue [issueNumber]"
const issueTitle = issue.data.issueDate ?? `Issue ${issueNum}`;
const pdfUrl = article.data.pdfLink ?? issue.data.pdfUrl; // article PDF wins; falls back to issue PDF

const bc = [
  { label: 'Home', href: '/' },
  { label: 'Journal', href: '/journal' },
  { label: issueTitle, href: `/journal/issue/issue-${String(issueNum).padStart(2, '0')}` },
  { label: title },
];

const SITE = 'https://brf2.pages.dev';
const idSlug = article.id.replace(/\.json$/, '');
const slugClean = idSlug.replace(/^article-/, '');
const pageUrl = `${SITE}/journal/issue/issue-${String(issueNum).padStart(2, '0')}/${slugClean}/`;

const publisher = {
  '@type': 'Organization',
  name: 'British Reformed Fellowship',
  url: SITE,
};

const encoding = pdfUrl ? {
  '@type': 'MediaObject',
  encodingFormat: 'application/pdf',
  url: pdfUrl,
} : null;

const articleLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  datePublished: datePublished ? new Date(datePublished).toISOString() : undefined,
  author: authorNames.map((name) => ({ '@type': 'Person', name })),
  mainEntityOfPage: pageUrl,
  publisher,
  isPartOf: {
    '@type': 'PublicationIssue',
    issueNumber: issueNum,
    datePublished: (() => {
      if (!issue.data.issueDate) return undefined;
      const d = new Date(issue.data.issueDate);
      return Number.isNaN(d.getTime()) ? undefined : d.toISOString();
    })(),
  },
};
if (encoding) articleLd.encoding = encoding;
---
<Site title={`${title} — ${issueTitle}`} description={`Article from ${issueTitle} of the British Reformed Journal.`} jsonLd={articleLd}>
  <section class="bg-brand-cream border-b border-brand-ink/10">
    <div class="max-w-3xl mx-auto px-5 sm:px-6 py-12 sm:py-10">
      <Breadcrumbs items={bc} />
      <p class="mt-3 text-xs uppercase tracking-wider text-muted">
        Article · {issueTitle}
      </p>
      <h1 class="mt-4 sm:mt-3 font-serif text-2xl sm:text-3xl md:text-4xl text-brand-ink leading-tight tracking-tight break-words">{title}</h1>
      {authorNames.length > 0 && (
        <p class="mt-3 text-sm text-brand-ink/75">
          {authorNames.join(', ')}
          {datePublished && (<span> · {new Date(datePublished).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</span>)}
        </p>
      )}
      {wordCount > 0 && (
        <p class="reading-meta" data-reading-meta>
          <span>{readingMinutes} min read</span>
          <span class="reading-meta-dot" aria-hidden="true"></span>
          <span>{wordCount.toLocaleString('en-GB')} words</span>
        </p>
      )}
    </div>
  </section>

  <section class="bg-white">
    <div class={`mx-auto px-6 py-10 ${headings.length > 0 ? 'lg:grid lg:grid-cols-[minmax(0,1fr)_14rem] lg:gap-10 lg:max-w-5xl' : 'max-w-3xl'}`}>
      <div class="min-w-0">
        {pdfUrl && (
          <div class="mb-8 flex items-center justify-between gap-3 rounded-sm border border-brand-ink/15 bg-brand-cream/50 px-4 py-3">
            <p class="text-xs uppercase tracking-wider text-muted">
              Read in your browser below, or open the original PDF
            </p>
            <a
              href={pdfUrl}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-sm bg-oxblood px-4 py-2 text-sm font-medium text-paper hover:bg-oxblood-hover"
            >
              Read PDF
            </a>
          </div>
        )}
        <ScriptureHover version="KJV" />
                <div class="article-toc-inline" data-toc-inline>
          <p class="article-toc-inline__label">Sections</p>
          <ol class="article-toc-inline-list">
            {headings.map((h) => (
              <li class={`article-toc-inline-item${h.depth === 3 ? " article-toc-inline-item--sub" : ""}`}>
                <a class="article-toc-inline-link" href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </div>
        <article id="top" class="prose prose-brand max-w-none" data-has-toc={headings.length > 0}>
          {Content && <Content />}
        </article>
        <div class="mt-10 border-t border-brand-ink/10 pt-6 flex items-center gap-3">
          {pdfUrl ? (
            <a
              href={pdfUrl}
              class="inline-flex items-center gap-2 rounded-sm bg-oxblood px-4 py-2 text-sm font-medium text-paper hover:bg-oxblood-hover"
            >
              Read PDF
            </a>
          ) : (
            <button
              type="button"
              disabled
              aria-disabled="true"
              class="inline-flex items-center gap-2 rounded-sm bg-brand-ink/10 px-4 py-2 text-sm font-medium text-brand-ink/40 cursor-not-allowed"
            >
              Read PDF
            </button>
          )}
        </div>
      </div>
      {headings.length > 0 && (
        <aside class="article-toc-aside hidden lg:block" data-toc-sidebar-panel>
          <ArticleToc headings={headings} />
        </aside>
      )}
    </div>
  </section>
<button
  type="button"
  class="back-to-top"
  data-back-to-top
  aria-label="Back to top"
  hidden
>
  <svg
    class="back-to-top__ring"
    viewBox="0 0 44 44"
    aria-hidden="true"
    focusable="false"
  >
    <circle class="back-to-top__ring-track" cx="22" cy="22" r="20"></circle>
    <circle
      class="back-to-top__ring-fill"
      cx="22"
      cy="22"
      r="20"
      pathLength="1"
    ></circle>
  </svg>
  <span class="back-to-top__icon" aria-hidden="true">
    <svg viewBox="0 0 20 20" focusable="false">
      <path
        d="M10 4 L4 11 M10 4 L16 11 M10 4 L10 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    </svg>
  </span>
</button>

<script>
  // Article reading affordances (issue #4):
  //   - top reading-progress bar + mirror onto the back-to-top ring
  //   - show back-to-top after ~1.5 viewports; click scrolls to top on
  //     desktop or opens the mobile TOC sidebar on small screens
  //   - auto-hide the site header on scroll-down, show on scroll-up
  //   - mobile inline <details> TOC is populated from the same headings
  //     as the desktop sidebar (single source of truth)
  (() => {
    const article = document.querySelector('article.prose');
    const button = document.querySelector('[data-back-to-top]');
    const ringFill = button ? button.querySelector('.back-to-top__ring-fill') : null;
    const header = document.querySelector('.site-header');
    const inlineToc = document.querySelector('[data-toc-inline]');
    const inlineList = inlineToc ? inlineToc.querySelector('.article-toc-inline-list') : null;
    const sidebarPanel = document.querySelector('[data-toc-sidebar-panel]');
    if (!article) return;

    // 1) Populate the mobile inline TOC from the same headings array used
    //    on desktop. The desktop <ol> is the source of truth — clone its
    //    rendered items so we never duplicate the heading list in JS.
    if (inlineList && sidebarPanel) {
      const src = sidebarPanel.querySelector('.article-toc-list');
      if (src) inlineList.innerHTML = src.innerHTML;
    }

    // 2) Inject a backdrop element for the mobile sidebar sheet.
    let backdrop = document.querySelector('[data-toc-sidebar-backdrop]');
    if (!backdrop) {
      backdrop = document.createElement('div');
      backdrop.setAttribute('data-toc-sidebar-backdrop', '');
      document.body.appendChild(backdrop);
    }

    const setSidebarOpen = (open) => {
      if (open) {
        document.documentElement.setAttribute('data-toc-sidebar', 'open');
      } else {
        document.documentElement.removeAttribute('data-toc-sidebar');
      }
    };
    backdrop.addEventListener('click', () => setSidebarOpen(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setSidebarOpen(false);
    });

    // 3) Click any TOC link in the sidebar → close the sheet on mobile.
    if (sidebarPanel) {
      sidebarPanel.addEventListener('click', (e) => {
        const a = e.target.closest('a[href^="#"]');
        if (!a) return;
        if (window.matchMedia('(max-width: 1023.98px)').matches) {
          setSidebarOpen(false);
        }
      });
    }

    // 4) Header auto-hide: hide on scroll-down past threshold, reveal on
    //    scroll-up. Uses data-scroll-hidden so CSS owns the transition.
    let lastY = window.scrollY;
    let headerHidden = false;
    const headerThreshold = 80;
    const updateHeader = () => {
      const y = window.scrollY;
      const delta = y - lastY;
      if (header && y > headerThreshold) {
        if (delta > 4 && !headerHidden) {
          header.dataset.scrollHidden = 'true';
          headerHidden = true;
        } else if (delta < -4 && headerHidden) {
          delete header.dataset.scrollHidden;
          headerHidden = false;
        }
      } else if (header && y <= headerThreshold && headerHidden) {
        delete header.dataset.scrollHidden;
        headerHidden = false;
      }
      lastY = y;
    };

    // 5) Single rAF-driven scroll handler: progress, button visibility,
    //    header visibility. Cheap and avoids layout thrash.
    let ticking = false;
    let lastShown = false;
    const updateProgress = () => {
      const rect = article.getBoundingClientRect();
      const total = rect.height + window.innerHeight;
      const scrolled = Math.min(Math.max(window.innerHeight - rect.top, 0), total);
      const pct = total > 0 ? scrolled / total : 0;
      const clamped = Math.max(0, Math.min(1, pct));
      if (ringFill) ringFill.style.setProperty('--reading-progress', String(clamped));

      if (button) {
        // Appear after ~1.5 viewports; hide near the end so the button
        // does not float over the footer.
        const pastThreshold = window.scrollY > window.innerHeight * 1.5;
        const nearEnd = clamped >= 0.98;
        const shouldShow = pastThreshold && !nearEnd;
        if (shouldShow !== lastShown) {
          button.hidden = !shouldShow;
          button.classList.toggle('is-visible', shouldShow);
          button.dataset.visible = shouldShow ? 'true' : 'false';
          lastShown = shouldShow;
        }
      }
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        updateProgress();
        updateHeader();
        ticking = false;
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });

    // 6) Back-to-top button: on desktop scroll to top; on mobile open the
    //    sidebar sheet instead. The ring still fills with reading progress
    //    in both modes.
    if (button) {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        if (window.matchMedia('(max-width: 1023.98px)').matches) {
          setSidebarOpen(true);
        } else {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    }

    // 7) Inline mobile TOC link clicks → smooth-scroll, close if open.
    if (inlineList) {
      inlineList.addEventListener('click', (e) => {
        const a = e.target.closest('a[href^="#"]');
        if (!a) return;
        const id = a.getAttribute('href').slice(1);
        const target = document.getElementById(id);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.replaceState(null, '', `#${id}`);
        }
      });
    }

    updateProgress();
    updateHeader();
  })();
</script>
<ScriptureHover />
<FootnoteHover />
</Site>