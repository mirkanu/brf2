---
import Site from '../../../../layouts/Site.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import { getCollection, render } from 'astro:content';
import { slugify } from '../../../../lib/format';

export const prerender = true;

export async function getStaticPaths() {
  const articles = await getCollection('journal');
  const issues = await getCollection('journalIssues');
  const issueByNumber = new Map(issues.map((i) => [i.data.issueNumber, i]));

  const paths: Array<{ params: { issue: string; slug: string }; props: { article: typeof articles[number]; issueNum: number; issue?: typeof issues[number] } }> = [];

  for (const article of articles) {
    if (article.data.section !== 'journal-article') continue;
    const issueNum = article.data.issueNumber;
    if (issueNum == null) continue;
    const idSlug = article.id.replace(/\.json$/, '');
    // Slug source = existing filename slug minus "article-" prefix
    const slug = idSlug.replace(/^article-/, '');
    const issue = issueByNumber.get(issueNum);
    if (!issue) continue;
    paths.push({
      params: { issue: `issue-${String(issueNum).padStart(2, '0')}`, slug },
      props: { article, issueNum, issue },
    });
  }

  return paths;
}

const { article, issue, issueNum } = Astro.props;
const { Content } = await render(article);

const { title, datePublished, authors } = article.data;
const authorNames = (authors ?? []).filter((s) => s && s.trim().length > 0);

// Display title: [issueDate] if provided, otherwise "Issue [issueNumber]"
const issueTitle = issue.data.issueDate ?? `Issue ${issueNum}`;
const pdfUrl = article.data.pdfLink ?? issue.data.pdfUrl; // article PDF wins; falls back to issue PDF

const bc = [
  { label: 'Home', href: '/' },
  { label: 'Journal', href: '/journal' },
  { label: issueTitle, href: `/journal/issue/issue-${String(issueNum).padStart(2, '0')}` },
  { label: title },
];

const SITE = 'https://brf2.pages.dev';
const idSlug = article.id.replace(/\.json$/, '');
const slugClean = idSlug.replace(/^article-/, '');
const pageUrl = `${SITE}/journal/issue/issue-${String(issueNum).padStart(2, '0')}/${slugClean}/`;

const publisher = {
  '@type': 'Organization',
  name: 'British Reformed Fellowship',
  url: SITE,
};

const encoding = pdfUrl ? {
  '@type': 'MediaObject',
  encodingFormat: 'application/pdf',
  url: pdfUrl,
} : null;

const articleLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  datePublished: datePublished ? new Date(datePublished).toISOString() : undefined,
  author: authorNames.map((name) => ({ '@type': 'Person', name })),
  mainEntityOfPage: pageUrl,
  publisher,
  isPartOf: {
    '@type': 'PublicationIssue',
    issueNumber: issueNum,
    datePublished: issue.data.issueDate ? new Date(issue.data.issueDate).toISOString() : undefined,
  },
};
if (encoding) articleLd.encoding = encoding;
---
<Site title={`${title} — ${issueTitle}`} description={`Article from ${issueTitle} of the British Reformed Journal.`} jsonLd={articleLd}>
  <section class="bg-brand-cream border-b border-brand-ink/10">
    <div class="max-w-3xl mx-auto px-6 py-10">
      <Breadcrumbs items={bc} />
      <p class="mt-3 text-xs uppercase tracking-wider text-muted">
        Article · {issueTitle}
      </p>
      <h1 class="mt-3 font-serif text-3xl md:text-4xl text-brand-ink leading-tight tracking-tight">{title}</h1>
      {authorNames.length > 0 && (
        <p class="mt-3 text-sm text-brand-ink/75">
          {authorNames.join(', ')}
          {datePublished && (<span> · {new Date(datePublished).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</span>)}
        </p>
      )}
    </div>
  </section>

  <section class="bg-white">
    <div class="max-w-3xl mx-auto px-6 py-10">
      <article class="prose prose-brand max-w-none">
        <Content />
      </article>
      <div class="mt-10 border-t border-brand-ink/10 pt-6 flex items-center gap-3">
        {pdfUrl ? (
          <a
            href={pdfUrl}
            class="inline-flex items-center gap-2 rounded-sm bg-oxblood px-4 py-2 text-sm font-medium text-paper hover:bg-oxblood-hover"
          >
            Read PDF
          </a>
        ) : (
          <button
            type="button"
            disabled
            aria-disabled="true"
            class="inline-flex items-center gap-2 rounded-sm bg-brand-ink/10 px-4 py-2 text-sm font-medium text-brand-ink/40 cursor-not-allowed"
          >
            Read PDF
          </button>
        )}
      </div>
    </div>
  </section>
</Site>