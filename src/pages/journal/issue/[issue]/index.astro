---
import Site from '../../../../layouts/Site.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const issues = await getCollection('journalIssues');
  const articles = await getCollection('journal');

  // Map issueNumber -> articles
  const byIssue = new Map<number, typeof articles>();
  for (const a of articles) {
    if (a.data.section !== 'journal-article') continue;
    const n = a.data.issueNumber;
    if (n == null) continue;
    if (!byIssue.has(n)) byIssue.set(n, [] as any);
    byIssue.get(n)!.push(a);
  }

  return issues
    .filter((i) => byIssue.has(i.data.issueNumber))
    .map((issue) => {
      const items = (byIssue.get(issue.data.issueNumber) ?? []).slice().sort(
        (a, b) => +new Date(a.data.datePublished) - +new Date(b.data.datePublished),
      );
      return {
        params: { issue: `issue-${String(issue.data.issueNumber).padStart(2, '0')}` },
        props: { issue, articles: items },
      };
    });
}

const { issue, articles } = Astro.props;
const issueNum = issue.data.issueNumber;
const issueTitle = issue.data.issueDate ?? `Issue ${issueNum}`;
const coverImg = issue.data.coverImage;
const pdfUrl = issue.data.pdfUrl;

const bc = [
  { label: 'Home', href: '/' },
  { label: 'Journal', href: '/journal' },
  { label: issueTitle },
];
---

<Site title={`${issueTitle} — British Reformed Journal`} description={`Articles from ${issueTitle} of the British Reformed Journal.`}>
  <section class="bg-brand-cream border-b border-brand-ink/10">
    <div class="max-w-5xl mx-auto px-6 py-12">
      <Breadcrumbs items={bc} />
      <div class="mt-6 grid gap-8 md:grid-cols-[14rem_1fr] md:items-start">
        {coverImg && (
          <img
            src={coverImg}
            alt={`${issueTitle} cover`}
            width="320"
            height="420"
            class="w-44 md:w-56 rounded-sm border border-brand-ink/15 shadow-sm"
            loading="lazy"
          />
        )}
        <div>
          <p class="text-xs uppercase tracking-widest text-muted">BRJ Issue</p>
          <h1 class="mt-2 font-serif text-4xl md:text-5xl text-brand-ink leading-tight tracking-tight">{issueTitle}</h1>
          <p class="mt-3 text-brand-ink/75">
            {articles.length} {articles.length === 1 ? 'article' : 'articles'} in this issue.
          </p>
          <div class="mt-5">
            {pdfUrl ? (
              <a
                href={pdfUrl}
                class="inline-flex items-center gap-2 rounded-sm bg-oxblood px-4 py-2 text-sm font-medium text-paper hover:bg-oxblood-hover"
              >
                Read PDF
              </a>
            ) : (
              <button
                type="button"
                disabled
                aria-disabled="true"
                class="inline-flex items-center gap-2 rounded-sm bg-brand-ink/10 px-4 py-2 text-sm font-medium text-brand-ink/40 cursor-not-allowed"
              >
                Read PDF
              </button>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="max-w-5xl mx-auto px-6 py-12">
      <h2 class="font-serif text-2xl text-brand-ink border-b border-brand-ink/20 pb-3">Articles</h2>
      <ul class="mt-6 divide-y divide-brand-ink/10 border-y border-brand-ink/10">
        {articles.map((article) => {
          const slug = article.id.replace(/\.json$/, '').replace(/^article-/, '');
          const url = `/journal/issue/issue-${String(issueNum).padStart(2, '0')}/${slug}`;
          const authors = (article.data.authors ?? []).filter((s) => s && s.trim().length > 0);
          return (
            <li class="py-4">
              <a href={url} class="block hover:underline">
                <div class="flex items-baseline justify-between gap-4">
                  <p class="font-serif text-lg text-brand-ink leading-snug">{article.data.title}</p>
                  {article.data.datePublished && (
                    <time class="shrink-0 text-xs text-muted tabular-nums">
                      {new Date(article.data.datePublished).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
                    </time>
                  )}
                </div>
                {authors.length > 0 && (
                  <p class="mt-1 text-xs text-brand-ink/65">{authors.join(', ')}</p>
                )}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</Site>