---
import Site from '../../../layouts/Site.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('journal');
const tagCount = new Map<string, number>();
for (const entry of allArticles) {
  if (entry.data.section !== 'journal-article') continue;
  for (const tag of entry.data.tags ?? []) {
    tagCount.set(tag, (tagCount.get(tag) ?? 0) + 1);
  }
}
const tags = Array.from(tagCount.entries()).sort((a, b) => b[1] - a[1]);
---
<Site title="Tags" description="Browse the British Reformed Journal by topic tag.">
  <div class="border-b border-[var(--border)] bg-[var(--surface-1)]">
    <div class="mx-auto max-w-6xl px-6 py-12">
      <h1 class="font-serif text-4xl md:text-5xl leading-[1.05] tracking-tight">Topics</h1>
      <p class="mt-3 text-[var(--muted)] max-w-2xl">
        Browse {tags.length} {tags.length === 1 ? 'topic' : 'topics'} tagged across the British Reformed Journal archive.
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-6 py-12">
    <ul class="flex flex-wrap gap-3">
      {tags.map(([tag, count]) => (
        <li>
          <a
            href={`/journal/tags/${encodeURIComponent(tag.toLowerCase().replace(/\s+/g, '-'))}`}
            class="inline-flex items-baseline gap-1.5 rounded-full border border-[var(--border)] bg-[var(--surface-1)] px-4 py-1.5 text-sm hover:border-[var(--accent)] hover:text-[var(--accent)]"
          >
            <span>{tag}</span>
            <span class="text-xs text-[var(--muted)] tabular-nums">{count}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Site>
