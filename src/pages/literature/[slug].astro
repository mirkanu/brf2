---
import Site from '../../layouts/Site.astro';
import ArticleBody from '../../components/ArticleBody.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allArticles = await getCollection('journal');
  return allArticles
    .filter((entry) => entry.data.section === 'literature')
    .map((entry) => ({
      params: { slug: entry.id.replace(/\.json$/, '') },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---
<Site title={entry.data.title} description={entry.data.description ?? entry.data.title}>
  <ArticleBody article={entry}>
    <Content />
  </ArticleBody>
</Site>
