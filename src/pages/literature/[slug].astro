---
import Site from '../../layouts/Site.astro';
import ArticleBody from '../../components/ArticleBody.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const allArticles = await getCollection('journal');
  return allArticles
    .filter((entry) => (entry.data as any).section === 'literature')
    .map((entry) => ({
      params: { slug: entry.id.replace(/\.json$/, '') },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const description = (entry.data as any).description ?? entry.data.title;
---
<Site title={entry.data.title} description={description}>
  <ArticleBody entry={entry}>
    <Content />
  </ArticleBody>
</Site>
