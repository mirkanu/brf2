---
import Site from '../../layouts/Site.astro';
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';

const allArticles = await getCollection('journal');
const articles = allArticles
  .filter((entry) => entry.data.section === 'literature')
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const years = Array.from(
  new Set(articles.map((a) => a.data.issueYear ?? new Date(a.data.datePublished).getFullYear())),
).sort((a, b) => Number(b) - Number(a));
---
<Site title="Literature" description="BRF literature — books, pamphlets, and translations curated by the British Reformed Fellowship.">
  <div class="border-b border-[var(--border)] bg-[var(--surface-1)]">
    <div class="mx-auto max-w-6xl px-6 py-12">
      <h1 class="font-serif text-4xl md:text-5xl leading-[1.05] tracking-tight">Literature</h1>
      <p class="mt-3 text-[var(--muted)] max-w-2xl">
        Books, pamphlets, and translations published or distributed by the British Reformed Fellowship.
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-6 py-12">
    {years.length > 0 && (
      <div class="mb-8 flex flex-wrap gap-2">
        {years.map((year) => (
          <span class="rounded-full border border-[var(--border)] bg-[var(--surface-2)] px-3 py-1 text-xs font-medium text-[var(--muted)]">
            {year}
          </span>
        ))}
      </div>
    )}

    {articles.length === 0 ? (
      <p class="text-[var(--muted)]">No literature entries yet.</p>
    ) : (
      <ul class="grid grid-cols-1 gap-x-8 gap-y-10 md:grid-cols-2 lg:grid-cols-3">
        {articles.map((entry) => <ArticleCard article={entry} />)}
      </ul>
    )}
  </div>
</Site>
