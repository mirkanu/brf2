---
import Site from "../layouts/Site.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
---

<Site title="Contact — British Reformed Fellowship" description="Get in touch with the British Reformed Fellowship.">
  <section class="bg-paper">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10 lg:py-14">
      <Breadcrumbs items={[{ label: "Contact" }]} />

      <header class="mt-6">
        <h1 class="font-serif text-4xl sm:text-5xl text-ink leading-tight">Contact</h1>
        <p class="mt-4 text-lg text-ink/70 max-w-2xl">
          The quickest way to reach us is by email. Choose the address below that best matches your enquiry, or use the form to write to the Secretary.
        </p>
      </header>

      <div class="mt-10 grid gap-10 lg:grid-cols-[1.4fr_1fr] lg:items-start">
        <article class="bg-white rounded-lg shadow-sm ring-1 ring-ink/10 p-6 sm:p-8">
          <h2 class="font-serif text-2xl text-ink">Send a message</h2>
          <p class="mt-2 text-sm text-ink/60">
            Submissions are delivered to the BRF Webmaster and answered in due course.
          </p>

          <form
            id="contact-form"
            method="POST"
            action="/api/contact"
            class="mt-6 space-y-5"
            data-state="idle"
          >
            <div>
              <label for="contact-name" class="block text-sm font-medium text-ink">Your name</label>
              <input
                id="contact-name"
                name="name"
                type="text"
                required
                autocomplete="name"
                class="mt-1.5 block w-full rounded-md border border-ink/20 bg-white px-3 py-2 text-ink shadow-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
              />
            </div>

            <div>
              <label for="contact-email" class="block text-sm font-medium text-ink">Your email</label>
              <input
                id="contact-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                class="mt-1.5 block w-full rounded-md border border-ink/20 bg-white px-3 py-2 text-ink shadow-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
              />
            </div>

            <div>
              <label for="contact-subject" class="block text-sm font-medium text-ink">Subject</label>
              <input
                id="contact-subject"
                name="subject"
                type="text"
                required
                class="mt-1.5 block w-full rounded-md border border-ink/20 bg-white px-3 py-2 text-ink shadow-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
              />
            </div>

            <div>
              <label for="contact-message" class="block text-sm font-medium text-ink">Message</label>
              <textarea
                id="contact-message"
                name="message"
                rows="6"
                required
                class="mt-1.5 block w-full rounded-md border border-ink/20 bg-white px-3 py-2 text-ink shadow-sm focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
              ></textarea>
            </div>

            <div class="flex items-center gap-4">
              <button
                type="submit"
                class="inline-flex items-center justify-center rounded-md bg-oxblood px-5 py-2.5 text-sm font-medium text-white shadow-sm transition hover:bg-oxblood/90 focus:outline-none focus:ring-2 focus:ring-oxblood focus:ring-offset-2 focus:ring-offset-paper disabled:cursor-not-allowed disabled:opacity-60"
                data-action="submit"
              >
                <span data-label="idle">Send message</span>
                <span data-label="sending" class="hidden">Sending…</span>
              </button>
              <p data-status class="text-sm text-ink/60"></p>
            </div>
          </form>

          <div
            id="contact-success"
            hidden
            class="mt-6 rounded-md bg-green-50 ring-1 ring-green-200 p-4 text-sm text-green-900"
          >
            Thanks — your message has been sent. We will reply from <strong>britishreformed.org</strong> shortly.
          </div>

          <div
            id="contact-error"
            hidden
            class="mt-6 rounded-md bg-red-50 ring-1 ring-red-200 p-4 text-sm text-red-900"
          >
            Sorry — your message could not be sent. Please try again, or email the Secretary directly.
          </div>
        </article>

        <aside class="space-y-4">
          <div class="rounded-lg bg-white p-5 shadow-sm ring-1 ring-ink/10">
            <h3 class="font-serif text-lg text-ink">Secretary</h3>
            <p class="mt-1 text-sm text-ink/70">General correspondence and enquiries.</p>
            <a
              href="mailto:secretary@britishreformed.org"
              class="mt-3 inline-block text-sm font-medium text-oxblood hover:underline break-all"
            >
              secretary@britishreformed.org
            </a>
          </div>

          <div class="rounded-lg bg-white p-5 shadow-sm ring-1 ring-ink/10">
            <h3 class="font-serif text-lg text-ink">Webmaster</h3>
            <p class="mt-1 text-sm text-ink/70">Technical issues with the site.</p>
            <a
              href="mailto:webmaster@britishreformed.org"
              class="mt-3 inline-block text-sm font-medium text-oxblood hover:underline break-all"
            >
              webmaster@britishreformed.org
            </a>
          </div>

          <div class="rounded-lg bg-white p-5 shadow-sm ring-1 ring-ink/10">
            <h3 class="font-serif text-lg text-ink">Editor</h3>
            <p class="mt-1 text-sm text-ink/70">Submissions for the BRF Journal.</p>
            <a
              href="mailto:editor@britishreformed.org"
              class="mt-3 inline-block text-sm font-medium text-oxblood hover:underline break-all"
            >
              editor@britishreformed.org
            </a>
          </div>

          <div class="rounded-lg bg-white p-5 shadow-sm ring-1 ring-ink/10">
            <h3 class="font-serif text-lg text-ink">Conference Secretary</h3>
            <p class="mt-1 text-sm text-ink/70">Conference bookings and queries.</p>
            <a
              href="mailto:conference-secretary@britishreformed.org"
              class="mt-3 inline-block text-sm font-medium text-oxblood hover:underline break-all"
            >
              conference-secretary@britishreformed.org
            </a>
          </div>

          <div class="rounded-lg bg-white p-5 shadow-sm ring-1 ring-ink/10">
            <h3 class="font-serif text-lg text-ink">Treasurer</h3>
            <p class="mt-1 text-sm text-ink/70">Membership, donations and subscriptions.</p>
            <a
              href="mailto:treasurer@britishreformed.org"
              class="mt-3 inline-block text-sm font-medium text-oxblood hover:underline break-all"
            >
              treasurer@britishreformed.org
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Site>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const successEl = document.getElementById("contact-success");
  const errorEl = document.getElementById("contact-error");
  const statusEl = form?.querySelector("[data-status]") as HTMLElement | null;
  const submitBtn = form?.querySelector('[data-action="submit"]') as HTMLButtonElement | null;

  if (form) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (form.dataset.state === "sending") return;

      form.dataset.state = "sending";
      successEl?.setAttribute("hidden", "");
      errorEl?.setAttribute("hidden", "");
      if (statusEl) statusEl.textContent = "";

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.querySelector('[data-label="idle"]')?.classList.add("hidden");
        submitBtn.querySelector('[data-label="sending"]')?.classList.remove("hidden");
      }

      try {
        const formData = new FormData(form);
        const response = await fetch("/api/contact", {
          method: "POST",
          headers: { Accept: "application/json" },
          body: formData,
        });

        if (response.ok) {
          successEl?.removeAttribute("hidden");
          form.reset();
        } else {
          errorEl?.removeAttribute("hidden");
        }
      } catch {
        errorEl?.removeAttribute("hidden");
      } finally {
        form.dataset.state = "idle";
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.querySelector('[data-label="idle"]')?.classList.remove("hidden");
          submitBtn.querySelector('[data-label="sending"]')?.classList.add("hidden");
        }
      }
    });
  }
</script>
