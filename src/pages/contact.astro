---
import Site from '../layouts/Site.astro';
---
<Site title="Contact — British Reformed Fellowship">
  <section class="mx-auto max-w-3xl px-6 py-12">
    <p class="font-sans text-xs uppercase tracking-[0.22em] text-oxblood">Contact</p>
    <h1 class="font-serif text-4xl md:text-5xl tracking-tight mt-3 text-balance">Get in touch.</h1>
    <p class="font-serif text-lg text-muted mt-5 max-w-2xl">For conference enquiries, journal subscription questions, or general correspondence.</p>

    <div class="font-serif mt-10 grid md:grid-cols-2 gap-12">
      <div>
        <h2 class="font-sans text-xs uppercase tracking-[0.22em] text-muted">By email</h2>
        <p class="mt-3 text-lg">secretary@britishreformed.org</p>
        <p class="font-sans text-sm text-muted mt-2">For general correspondence and conference enquiries.</p>
      </div>
      <div>
        <h2 class="font-sans text-xs uppercase tracking-[0.22em] text-muted">By post</h2>
        <p class="mt-3 leading-relaxed">
          British Reformed Fellowship<br />
          c/o The Secretary<br />
          [Registered office address]
        </p>
      </div>
      <div>
        <h2 class="font-sans text-xs uppercase tracking-[0.22em] text-muted">Journal editors</h2>
        <p class="mt-3 text-lg">journal@britishreformed.org</p>
        <p class="font-sans text-sm text-muted mt-2">For submissions, reviews, and editorial correspondence.</p>
      </div>
      <div>
        <h2 class="font-sans text-xs uppercase tracking-[0.22em] text-muted">Donations</h2>
        <p class="mt-3">See the <a href="/donate" class="text-oxblood no-underline hover:underline">Donate</a> page for bank details and Gift Aid information.</p>
      </div>
    </div>
  </section>
</Site>
