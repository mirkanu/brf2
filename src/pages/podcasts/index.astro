---
import Site from '../../layouts/Site.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { fmtDate } from '../../lib/format';

const all = await getCollection('podcasts');
const sorted = all
  .filter((p) => p.data.datePublished)
  .sort((a, b) => b.data.datePublished.localeCompare(a.data.datePublished));
const grouped = new Map<string, typeof all>();
for (const p of sorted) {
  const decade = Math.floor((new Date(p.data.datePublished).getFullYear() || 0) / 10) * 10;
  const k = `${decade}s`;
  if (!grouped.has(k)) grouped.set(k, []);
  grouped.get(k)!.push(p);
}
const decades = [...grouped.keys()].sort().reverse();
---
<Site title="Podcasts — British Reformed Fellowship" description="Audio sermons and lectures from BRF conferences and contributors.">
  <section class="bg-brand-cream border-b border-brand-ink/10">
    <div class="max-w-5xl mx-auto px-6 py-12">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Podcasts' }]} />
      <h1 class="mt-4 font-serif text-4xl md:text-5xl text-brand-ink">Podcasts</h1>
      <p class="mt-3 max-w-2xl text-brand-ink/75">
        Sermons and lectures — most from BRF conferences — in audio form. Streaming links live on each item page.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="max-w-5xl mx-auto px-6 py-12">
      {decades.map((d) => (
        <div class="mt-8 first:mt-0">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-brand-ink/60">{d}</h2>
          <ul class="mt-3 divide-y divide-brand-ink/10 border-y border-brand-ink/10">
            {grouped.get(d)!.map((p) => (
              <li class="py-4">
                <a href={`/podcasts/${p.id.replace(/\.json$/, '')}`} class="group flex flex-wrap items-baseline justify-between gap-x-6 hover:bg-brand-cream/40 -mx-2 px-2 py-1 rounded-sm">
                  <span class="font-serif text-lg text-brand-ink group-hover:underline">{p.data.title}</span>
                  <span class="text-xs text-brand-ink/55">{fmtDate(p.data.datePublished)}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Site>