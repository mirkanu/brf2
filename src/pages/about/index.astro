---
import Site from '../../layouts/Site.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleToc from '../../components/ArticleToc.astro';

// Hand-curated outline for the static About page (no MD body, so we build
// the headings ourselves and reuse the same ArticleToc component + scroll
// spy that journal article templates use).
const headings = [
  { depth: 2, slug: 'doctrinal-basis', text: 'Doctrinal Basis' },
  { depth: 2, slug: 'membership', text: 'Membership & Subscription' },
  { depth: 2, slug: 'general-council', text: 'General Council' },
];
---
<Site title="About the BRF — British Reformed Fellowship">
  <section class="bg-brand-cream border-b border-brand-ink/10">
    <div class="max-w-5xl mx-auto px-6 py-12">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'About' }]} />
      <p class="mt-4 font-sans text-xs uppercase tracking-[0.22em] text-oxblood">About</p>
      <h1 class="mt-3 font-serif text-4xl md:text-5xl text-brand-ink text-balance">About the BRF</h1>
      <p class="mt-4 max-w-2xl font-serif text-lg text-brand-ink/80 text-balance">
        Founded in 1990 by a group of Reformed Christians concerned for the defence of the Historic Reformed Faith in the British Isles.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto px-5 sm:px-6 pt-12 sm:pt-10 pb-16 lg:grid lg:grid-cols-[minmax(0,1fr)_14rem] lg:gap-10 lg:max-w-5xl">
      <div class="min-w-0">
        <nav aria-label="Sections" class="article-toc-inline lg:hidden" data-toc-inline>
          <p class="article-toc-inline__label">Sections</p>
          <ol class="article-toc-inline-list">
            {headings.map((h) => (
              <li class={`article-toc-inline-item${h.depth === 3 ? ' article-toc-inline-item--sub' : ''}`}>
                <a class="article-toc-inline-link" href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>

        <article id="top" class="prose prose-brand max-w-none" data-has-toc={headings.length > 0}>
          <section id="doctrinal-basis" class="scroll-mt-24">
            <h2 class="font-serif text-2xl text-brand-ink">Doctrinal Basis</h2>
            <blockquote class="font-serif italic text-brand-ink/85 mt-4 border-l-2 border-oxblood pl-4">
              &ldquo;The basis of the BRF shall be the inspired, infallible, inerrant Scriptures of the Old and New Testaments as summarized and systemized in the Reformed confessions, specifically the Three Forms of Unity and the Westminster Standards.&rdquo;
            </blockquote>
            <ol class="font-serif text-brand-ink/85 mt-6 space-y-2 list-decimal pl-6">
              <li>The Divine inspired, infallible, and inerrant Holy Scriptures</li>
              <li>
                The Doctrine set forth in:
                <ol class="mt-2 space-y-2 list-decimal pl-6">
                  <li>
                    The <em>Three Forms of Unity</em>, being:
                    <ul class="mt-2 space-y-1 list-disc pl-6">
                      <li>The <em>Canons of Dordt</em>,</li>
                      <li>The <em>Belgic Confession</em>,</li>
                      <li>The <em>Heidelberg Catechism</em></li>
                    </ul>
                  </li>
                  <li>The <em>Westminster Standards</em></li>
                </ol>
              </li>
            </ol>
          </section>

          <section id="membership" class="scroll-mt-24 mt-12">
            <h2 class="font-serif text-2xl text-brand-ink">Membership &amp; Subscription</h2>
            <p class="font-serif text-brand-ink/85 mt-3">
              Subscriptions to the BRJ and membership for the BRF are managed by the Covenant Protestant Reformed Church web store:
            </p>
            <p class="mt-6">
              <a
                href="https://cprc.co.uk/product-category/books/periodicals/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-sm bg-oxblood px-5 py-2.5 text-sm font-medium text-white hover:bg-oxblood-hover transition-colors no-underline"
              >
                <span>Membership / Subscription</span>
                <span aria-hidden="true">↗</span>
              </a>
            </p>
          </section>

          <section id="general-council" class="scroll-mt-24 mt-12">
            <h2 class="font-serif text-2xl text-brand-ink">General Council</h2>
            <dl class="mt-4 grid gap-4 sm:grid-cols-2">
              <div class="rounded-sm border border-brand-ink/15 bg-brand-cream/40 p-4">
                <dt class="font-sans text-xs uppercase tracking-[0.18em] text-muted">Chairman</dt>
                <dd class="font-serif text-brand-ink mt-1">Rev. Angus Stewart</dd>
                <dd class="text-sm mt-1"><a class="text-oxblood no-underline hover:underline break-all" href="mailto:revangusstewart@tiscali.co.uk">revangusstewart@tiscali.co.uk</a></dd>
              </div>
              <div class="rounded-sm border border-brand-ink/15 bg-brand-cream/40 p-4">
                <dt class="font-sans text-xs uppercase tracking-[0.18em] text-muted">Secretary</dt>
                <dd class="font-serif text-brand-ink mt-1">Mr. Brian Crossett</dd>
                <dd class="text-sm mt-1"><a class="text-oxblood no-underline hover:underline break-all" href="mailto:briancrossett@hotmail.com">briancrossett@hotmail.com</a></dd>
              </div>
              <div class="rounded-sm border border-brand-ink/15 bg-brand-cream/40 p-4">
                <dt class="font-sans text-xs uppercase tracking-[0.18em] text-muted">Treasurer</dt>
                <dd class="font-serif text-brand-ink mt-1">Mr. Dale Mansona</dd>
                <dd class="text-sm mt-1"><a class="text-oxblood no-underline hover:underline break-all" href="mailto:dalemarmansona@gmail.com">dalemarmansona@gmail.com</a></dd>
              </div>
              <div class="rounded-sm border border-brand-ink/15 bg-brand-cream/40 p-4">
                <dt class="font-sans text-xs uppercase tracking-[0.18em] text-muted">Journal Editor</dt>
                <dd class="font-serif text-brand-ink mt-1">Mr. Samuel Watterson</dd>
                <dd class="text-sm mt-1"><a class="text-oxblood no-underline hover:underline break-all" href="mailto:samuel.m.watterson@gmail.com">samuel.m.watterson@gmail.com</a></dd>
              </div>
              <div class="rounded-sm border border-brand-ink/15 bg-brand-cream/40 p-4">
                <dt class="font-sans text-xs uppercase tracking-[0.18em] text-muted">Conference Secretary</dt>
                <dd class="font-serif text-brand-ink mt-1">Mr. Brian Harris</dd>
                <dd class="text-sm mt-1"><a class="text-oxblood no-underline hover:underline break-all" href="mailto:brian_neath@btinternet.com">brian_neath@btinternet.com</a></dd>
              </div>
            </dl>
          </section>
        </article>
      </div>

      <aside class="article-toc-aside hidden lg:block" data-toc-sidebar-panel>
        <ArticleToc headings={headings} />
      </aside>
    </div>
  </section>
</Site>
