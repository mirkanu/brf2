---
import Site from '../../layouts/Site.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
---
<Site title="Contact — British Reformed Fellowship">
  <section class="bg-brand-cream border-b border-brand-ink/10">
    <div class="max-w-5xl mx-auto px-6 py-12">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'About', href: '/about/' }, { label: 'Contact' }]} />
      <p class="mt-4 font-sans text-xs uppercase tracking-[0.22em] text-oxblood">Get in touch</p>
      <h1 class="mt-3 font-serif text-4xl md:text-5xl text-brand-ink text-balance">Contact the BRF</h1>
      <p class="mt-4 max-w-2xl font-serif text-lg text-brand-ink/80 text-balance">
        Use the form below, or write directly to the Secretary or another member of the General Council.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-12 lg:grid lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-12">
      <form
        id="brf-contact-form"
        class="font-serif max-w-2xl"
        method="POST"
        action="/api/contact"
        novalidate
      >
        <div class="grid gap-5 sm:grid-cols-2">
          <div class="sm:col-span-2">
            <label for="contact-name" class="font-sans text-xs uppercase tracking-[0.18em] text-muted">Name</label>
            <input
              id="contact-name"
              name="name"
              type="text"
              required
              autocomplete="name"
              class="mt-2 block w-full rounded-sm border border-brand-ink/20 bg-paper px-3 py-2 font-serif text-brand-ink shadow-sm focus:border-oxblood focus:outline-none focus:ring-1 focus:ring-oxblood"
            />
          </div>
          <div>
            <label for="contact-email" class="font-sans text-xs uppercase tracking-[0.18em] text-muted">Email</label>
            <input
              id="contact-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class="mt-2 block w-full rounded-sm border border-brand-ink/20 bg-paper px-3 py-2 font-serif text-brand-ink shadow-sm focus:border-oxblood focus:outline-none focus:ring-1 focus:ring-oxblood"
            />
          </div>
          <div>
            <label for="contact-subject" class="font-sans text-xs uppercase tracking-[0.18em] text-muted">Subject</label>
            <input
              id="contact-subject"
              name="subject"
              type="text"
              required
              class="mt-2 block w-full rounded-sm border border-brand-ink/20 bg-paper px-3 py-2 font-serif text-brand-ink shadow-sm focus:border-oxblood focus:outline-none focus:ring-1 focus:ring-oxblood"
            />
          </div>
          <div class="sm:col-span-2">
            <label for="contact-message" class="font-sans text-xs uppercase tracking-[0.18em] text-muted">Message</label>
            <textarea
              id="contact-message"
              name="message"
              rows="6"
              required
              class="mt-2 block w-full rounded-sm border border-brand-ink/20 bg-paper px-3 py-2 font-serif text-brand-ink shadow-sm focus:border-oxblood focus:outline-none focus:ring-1 focus:ring-oxblood"
            ></textarea>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-4">
          <button
            type="submit"
            class="inline-flex items-center gap-2 rounded-sm bg-oxblood px-5 py-2.5 text-sm font-medium text-paper hover:bg-oxblood-hover transition-colors disabled:cursor-not-allowed disabled:opacity-60"
            data-submit
          >
            <span data-submit-label>Send message</span>
            <svg data-submit-spinner class="hidden size-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-opacity="0.25" stroke-width="4"></circle>
              <path d="M22 12a10 10 0 0 1-10 10" stroke="currentColor" stroke-width="4" stroke-linecap="round"></path>
            </svg>
          </button>
          <p data-form-status class="font-serif text-sm text-muted" role="status" aria-live="polite"></p>
        </div>
      </form>

      <aside class="mt-12 lg:mt-0 lg:border-l lg:border-brand-ink/15 lg:pl-10">
        <h2 class="font-sans text-xs uppercase tracking-[0.22em] text-muted">Direct email</h2>
        <ul class="mt-3 space-y-3 font-serif text-brand-ink/85">
          <li>
            <span class="block font-medium">Secretary</span>
            <a class="text-oxblood no-underline hover:underline break-all" href="mailto:secretary@britishreformed.org">secretary@britishreformed.org</a>
            <span class="block text-sm text-muted">For general correspondence and conference enquiries.</span>
          </li>
          <li>
            <span class="block font-medium">Journal editors</span>
            <a class="text-oxblood no-underline hover:underline break-all" href="mailto:journal@britishreformed.org">journal@britishreformed.org</a>
            <span class="block text-sm text-muted">For submissions, reviews, and editorial correspondence.</span>
          </li>
        </ul>
      </aside>
    </div>
  </section>

  <script>
    const form = document.getElementById('brf-contact-form');
    if (form instanceof HTMLFormElement) {
      const status = form.querySelector('[data-form-status]');
      const submit = form.querySelector('[data-submit]');
      const label = form.querySelector('[data-submit-label]');
      const spinner = form.querySelector('[data-submit-spinner]');

      const setStatus = (message, tone) => {
        if (status) {
          status.textContent = message;
          status.dataset.tone = tone || '';
          if (tone === 'error') status.classList.add('text-oxblood');
          else status.classList.remove('text-oxblood');
        }
      };

      const setBusy = (busy) => {
        if (submit instanceof HTMLButtonElement) submit.disabled = busy;
        if (label instanceof HTMLElement) label.textContent = busy ? 'Sending…' : 'Send message';
        if (spinner instanceof HTMLElement) spinner.classList.toggle('hidden', !busy);
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        setStatus('');
        setBusy(true);
        try {
          const data = new FormData(form);
          const response = await fetch(form.action, {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: data,
          });
          if (!response.ok) {
            const text = await response.text().catch(() => '');
            throw new Error(text || `Request failed (${response.status})`);
          }
          form.reset();
          setStatus('Thanks for your message — we will get back to you shortly.', 'ok');
        } catch (error) {
          console.error(error);
          setStatus('Sorry — your message could not be sent. Please try again, or email the Secretary directly.', 'error');
        } finally {
          setBusy(false);
        }
      });
    }
  </script>
</Site>
