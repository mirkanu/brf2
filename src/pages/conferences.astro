---
import Site from '../layouts/Site.astro';

const upcoming = {
  year: 2026,
  theme: 'Knowing God',
  venue: 'Castlewellan Castle, Northern Ireland',
  dates: '1–8 August 2026',
  speakers: ['Rev. John Greer', 'Rev. Dr. N. Shepherd', 'Rev. A. Stewart'],
};

const past = [
  { year: 2024, theme: 'Eschatology', venue: 'Cloverley Hall, Shropshire', dates: '3–10 August', sphere: 'rescheduled' },
  { year: 2022, theme: 'Union with Jesus Christ', venue: 'Castlewellan, Northern Ireland', dates: '9–16 July', sphere: 'rescheduled' },
  { year: 2018, theme: 'The Reformed Family — According to the Word of God', venue: 'Hebron Hall, Wales', dates: '21–28 July' },
  { year: 2016, theme: '"Behold, I Come Quickly": The Reformed, Biblical Truth of the End', venue: 'Castlewellan, Northern Ireland', dates: '16–23 July' },
  { year: 2014, theme: '"Be Ye Holy": The Reformed Truth of Sanctification', venue: 'Gartmore House, Scotland', dates: '26 July – 2 Aug' },
  { year: 2012, theme: '"Ye Shall Be My Witnesses"', venue: 'Lorne House, Co. Down', dates: '28 July – 4 Aug' },
  { year: 2010, theme: 'The Word of God for our Generation', venue: 'Hebron Hall, Wales', dates: '7–14 Aug' },
  { year: 2008, theme: 'The Work of the Holy Spirit', venue: 'The Share Centre, N. Ireland', dates: '25 July – 1 Aug' },
];
---
<Site title="Conferences — British Reformed Fellowship">
  <section class="mx-auto max-w-6xl px-6 pt-12 pb-10">
    <p class="font-sans text-xs uppercase tracking-[0.22em] text-oxblood">Conferences</p>
    <h1 class="font-serif text-4xl md:text-5xl tracking-tight mt-3 text-balance">A week of preaching, teaching, and fellowship.</h1>
    <p class="font-serif text-lg text-muted mt-5 max-w-2xl">Held annually since the 1980s, rotating between venues across the United Kingdom and Ireland.</p>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-16">
    <article class="bg-[#2a1a14] text-paper p-8 md:p-12 grid md:grid-cols-[1fr_auto] gap-8 items-end">
      <div>
        <p class="font-sans text-xs uppercase tracking-[0.22em] opacity-70">Upcoming · {upcoming.year}</p>
        <h2 class="font-serif text-3xl md:text-5xl mt-3 text-balance">{upcoming.theme}</h2>
        <p class="font-serif text-lg mt-4 opacity-90">{upcoming.venue}</p>
        <p class="font-sans text-sm mt-2 opacity-75">{upcoming.dates}</p>
        <p class="font-sans text-sm mt-6 opacity-75">Speakers: {upcoming.speakers.join(' · ')}</p>
      </div>
      <a href="/contact" class="font-sans text-sm bg-paper text-ink px-5 py-2.5 rounded-sm no-underline whitespace-nowrap hover:bg-rule">Enquire</a>
    </article>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-20">
    <h2 class="font-sans text-xs uppercase tracking-[0.22em] text-muted">Past conferences</h2>
    <ul class="mt-6 divide-y divide-rule border-y border-rule">
      {past.map((c) => (
        <li class="py-5 grid md:grid-cols-[80px_1fr_auto] gap-6 items-baseline">
          <span class="font-serif text-2xl text-oxblood">{c.year}</span>
          <div>
            <p class="font-serif text-lg leading-snug">{c.theme}</p>
            <p class="font-sans text-sm text-muted mt-1">{c.venue} · {c.dates}</p>
          </div>
          <span class="font-sans text-xs uppercase tracking-[0.18em] text-muted">{c.sphere ?? 'held'}</span>
        </li>
      ))}
    </ul>
  </section>
</Site>
